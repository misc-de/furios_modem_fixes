+class ModemManagerBus(MessageBus):
+    """The ObjectManager at /org/freedesktop/ModemManager1: finished modems, and
+    nothing else, and not one word before the bus name is ours.
+
+    Everything a client learns about a modem arrives through one of two doors:
+    the GetManagedObjects it calls when it starts, and the InterfacesAdded it
+    hears afterwards. Both doors have to agree, both have to be shut until the
+    modem is built, and both have to stay shut for every object that is not a
+    modem. Six defects in this tree came from one of them standing open:
+
+      12  the SIM and every bearer were handed out as managed objects. phosh
+          takes the first entry of the list on the documented assumption that
+          "Modem interface is always present", remembers it, and never looks at
+          another object - so a bearer in first place meant no signal icon at
+          all. First place is hash order, which is why it came and went.
+      16  the modem was announced by throwing the bus name away and taking it
+          back, because the automatic announcement goes out from the object's
+          own path and reaches nobody. In the moment nobody owns the name a
+          client's call is refused by the catch-all deny and GLib never asks
+          again.
+      21  the modem was announced before the name was ours. NetworkManager
+          built its modem from it and every method it then called went to a
+          name belonging to nobody; it keeps that modem for the rest of the
+          boot.
+      22  the manager object itself was announced as a managed object.
+          NetworkManager wrapped it, found no Modem interface in it and logged
+          `doesn't have the Modem interface, ignoring` - and on that same boot
+          built /ril_0 from a modem whose State and Sim were not filled in yet.
+
+    The first three were each fixed by narrowing a predicate over path strings.
+    That is what kept failing: `_is_announced` answered True for
+    /org/freedesktop/ModemManager1, because the manager path is not below
+    itself, and the boot of 14.9. 14:18 came up with no mobile data.
+
+    So this class does not decide. It keeps a list.
+
+    `_published` is the set of modem paths a client may see. A path is in it
+    because `modem_ready` put it there and the bus name was ours at that
+    moment - never because a rule about its spelling said it belonged there.
+    GetManagedObjects answers from that set and the announcement is sent for
+    its members only, so the two doors cannot disagree and neither can be
+    opened by an object nobody published: not the manager, not a SIM, not a
+    bearer, not a half-built modem.
+    """
+
+    __slots__ = ('_published', '_waiting', '_name_is_ours')
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        # The managed objects, named one by one. See the class docstring: this
+        # is the whole mechanism.
+        self._published = set()
+        # Modems that reported themselves built while the bus name was still
+        # unowned, in the order they reported it.
+        self._waiting = []
+        self._name_is_ours = False
+
+    def modem_ready(self, path):
+        """The modem at this path is built; a client may be told about it.
+
+        This is the only way anything becomes visible, and it is called from
+        one place: the end of the modem's own build. It used to be called from
+        the middle of `set_props` as well, right after the modem is switched
+        online and long before `State` and `Sim` are filled in. On the boot of
+        14.9. 14:18 that is the call that won, and NetworkManager read the
+        modem it produced:
+
+            device (/ril_0): modem state 'failed'
+            modem-broadband[/ril_0]: failed to retrieve SIM object: No SIM
+            object available
+
+        `State` was still -1 and `Sim` still '/', which is what those two lines
+        say. Twenty milliseconds later both were right, and it made no
+        difference: NetworkManager keeps the modem it built
+        (`already exists, ignoring`) and the phone had no mobile data for the
+        rest of the boot.
+        """
+        if not self._name_is_ours:
+            # Nobody could act on it yet - see name_acquired.
+            if path not in self._waiting:
+                self._waiting.append(path)
+            return
+
+        self._publish(path)
+
+    def name_acquired(self):
+        """org.freedesktop.ModemManager1 is ours; release what was waiting.
+
+        An announcement made before the name is owned is worse than no
+        announcement at all. NetworkManager watches the bus, not the name: it
+        hears the InterfacesAdded and builds its modem from it at once, and
+        every method it then calls goes to a name that belongs to nobody. The
+        bus answers UnknownMethod for each of them and the phone is left with
+        a modem whose Modem interface has no methods, which it then keeps.
+        """
+        self._name_is_ours = True
+        waiting, self._waiting = self._waiting, []
+        for path in waiting:
+            self._publish(path)
+
+    def _publish(self, path):
+        """Put the modem in the managed set and say so, once."""
+        if not path.startswith(MM_MODEM_PREFIX):
+            # Only modems are managed objects, and this is where that is
+            # guaranteed rather than assumed of the caller. ModemManager
+            # exports SIMs and bearers on the bus at their own paths but keeps
+            # them out of the ObjectManager; a client that finds one there
+            # wraps it, asks for its Modem interface, gets NULL and drops it.
+            # That is defect 12 for a bearer and defect 22 for the manager
+            # object itself.
+            return
+
+        if path in self._published:
+            # Announced once, with everything it has, the way ModemManager
+            # itself does it. Clients that want to know about later changes
+            # have PropertiesChanged for that.
+            return
+
+        interfaces = list(self._path_exports.get(path, {}).values())
+        if not interfaces:
+            # Nothing exported at that path: there is no object to announce,
+            # and putting the path in the set would make GetManagedObjects
+            # promise one.
+            return
+
+        self._published.add(path)
+        self._announce(path, interfaces)
+
+    def _arm_fallback(self, path, delay=10):
+        # A modem that never reports itself built would otherwise stay
+        # invisible for ever - a worse failure than the one this class exists
+        # for. Every path through MMModemInterface ends in modem_ready, so
+        # this net should never catch anything; it is here because "should" is
+        # not a guarantee and a phone with no modem is not an acceptable way
+        # to find out.
+        try:
+            loop = asyncio.get_running_loop()
+        except RuntimeError:
+            return
+        loop.call_later(delay, self.modem_ready, path)
+
+    def _default_get_managed_objects_handler(self, msg, send_reply):
+        if msg.path != MM_ROOT:
+            return super()._default_get_managed_objects_handler(msg, send_reply)
+
+        # dbus_fast synthesises the reply from its export table, which is every
+        # path below this one - the SIM, every bearer, every modem whether it
+        # is finished or not:
+        #
+        #     nodes = [node for node in self._path_exports
+        #              if msg.path == "/" or node.startswith(msg.path + "/")]
+        #
+        # Real ModemManager builds its ObjectManager from modem skeletons
+        # alone and a client reaches a bearer through the modem's `Bearers`
+        # property, never by enumeration. So the table is narrowed to the
+        # published set for the length of the call: the reply is upstream's,
+        # the guest list is ours.
+        #
+        # The handler reads _path_exports synchronously to pick its nodes and
+        # their interfaces; the property callbacks that finish the reply later
+        # never touch it. Narrowing it for the length of the call is therefore
+        # enough, and it reuses dbus_fast's logic rather than copying it.
+        every = self._path_exports
+        self._path_exports = {
+            path: interfaces
+            for path, interfaces in every.items()
+            if path in self._published
+        }
+        try:
+            return super()._default_get_managed_objects_handler(msg, send_reply)
+        finally:
+            self._path_exports = every
+
+    def _emit_interface_added(self, path, interface):
+        """Export nothing, announce nothing - publishing is `modem_ready`.
+
+        dbus_fast announces every single export, and both halves of that are
+        wrong here. It sends the signal from the path of the object that
+        changed; the specification puts InterfacesAdded on the manager's path
+        with the object path as its first argument, and that is where every
+        client subscribes - NetworkManager, phosh and chatty all watch
+        /org/freedesktop/ModemManager1 and hear nothing otherwise. And it
+        sends one per interface, while ofono2mm exports fifteen of them in a
+        row: libmm-glib builds its MMObject from the first announcement that
+        names the object, and NetworkManager throws that object away for good
+        when the Modem interface is not in it.
+
+        Suppressing it here is what leaves `modem_ready` as the only door.
+        """
+        if self._disconnected:
+            return
+
+        if path in self._published:
+            # An object a client already knows about, gaining an interface.
+            # That is what InterfacesAdded is for and there is nothing unsafe
+            # about it any more: the modem is whole, the name is ours, and the
+            # client can act on what it hears. It still goes out from the
+            # manager's path rather than the object's.
+            self._announce(path, [interface])
+            return
+
+        if path.startswith(MM_MODEM_PREFIX) and interface.name == MM_MODEM_IFACE:
+            self._arm_fallback(path)
+
+    def _emit_interface_removed(self, path, removed_interfaces):
+        # Only a published modem was ever announced, so only a published modem
+        # can be withdrawn - and only once its last interface is gone. A modem
+        # that merely loses one of the fifteen is still a modem; saying it
+        # disappeared would make NetworkManager drop a working connection.
+        if self._disconnected or path not in self._published:
+            return
+        if path in self._path_exports:
+            return
+
+        self._published.discard(path)
+        self.send(Message.new_signal(
+            path=MM_ROOT,
+            interface='org.freedesktop.DBus.ObjectManager',
+            member='InterfacesRemoved',
+            signature='oas',
+            body=[path, removed_interfaces],
+        ))
+
+    def _announce(self, path, interfaces):
+        """Send one InterfacesAdded from the manager's path, with everything.
+
+        Every announcement in this class goes out through here, so this is
+        where a bus on its way out stops talking.
+        """
+        if self._disconnected:
+            return
+
+        body = {iface.name: None for iface in interfaces}
+
+        def collected(iface, values, _user_data, error):
+            if error is not None:
+                # dbus_fast sends the signal anyway in this case, with whatever
+                # it did read. A modem announced with some properties missing
+                # is still better than a modem nobody hears about; the client
+                # asks for what it needs afterwards.
+                ofono2mm_print(f"Some properties of {iface.name} are missing "
+                               f"from the announcement of {path}: {error}", True)
+                values = {}
+            body[iface.name] = values
+            if any(value is None for value in body.values()):
+                return
+            self.send(Message.new_signal(
+                path=MM_ROOT,
+                interface='org.freedesktop.DBus.ObjectManager',
+                member='InterfacesAdded',
+                signature='oa{sa{sv}}',
+                body=[path, body],
+            ))
+
+        for iface in interfaces:
+            ServiceInterface._get_all_property_values(iface, collected)
+
