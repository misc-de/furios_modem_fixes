+MM_BUS_NAME = 'org.freedesktop.ModemManager1'
+MM_ROOT = '/org/freedesktop/ModemManager1'
+MM_MODEM_PREFIX = MM_ROOT + '/Modem/'
+MM_MODEM_IFACE = 'org.freedesktop.ModemManager1.Modem'
