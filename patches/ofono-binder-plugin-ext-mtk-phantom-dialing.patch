+/*
+ * The dial request answers OK as soon as the modem has accepted the
+ * command, which can be after the network has already refused the call.
+ * Reporting OK then makes the core synthesize a "dialing" call that no
+ * later event refers to - so a call that is already gone fails the dial.
+ */
+static
+void
+mtk_ims_call_dial_complete(
+    RadioRequest* req,
+    RADIO_TX_STATUS status,
+    RADIO_RESP resp,
+    RADIO_ERROR error,
+    const GBinderReader* args,
+    gpointer user_data)
+{
+    MtkImsCallResultRequest* result_req = user_data;
+    MtkImsCall* self = THIS(result_req->ext);
+    gboolean failed = self->dial_failed;
+
+    self->dial_pending = FALSE;
+    self->dial_failed = FALSE;
+    if (failed) {
+        DBG("dial answered after the call was dropped - reporting failure");
+    }
+    if (result_req->complete) {
+        result_req->complete(result_req->ext,
+            (status != RADIO_TX_STATUS_OK || error || failed) ?
+            BINDER_EXT_CALL_RESULT_ERROR : BINDER_EXT_CALL_RESULT_OK,
+            result_req->user_data);
+    }
+}
