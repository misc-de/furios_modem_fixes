+    def update_signal_quality(self, quality):
+        """
+        Called by the Signal interface whenever it has fresh serving cell
+        measurements, as the fallback source for SignalQuality on modems whose
+        driver reports no signal strength to oFono.
+        """
+        ofono2mm_print(f"Signal quality from cell measurements is {quality}%", self.verbose)
+        self.signal_quality = quality
+
+        # Anything below registered has no meaningful bar, and set_props()
+        # clears SignalQuality for those states anyway.
+        if self.props['State'].value < 8:
+            return
+
+        # If the driver does publish a strength, that one wins; this is only a
+        # stand-in for the drivers that never do.
+        if 'org.ofono.NetworkRegistration' in self.ofono_interface_props and \
+                'Strength' in self.ofono_interface_props['org.ofono.NetworkRegistration'].props:
+            return
+
+        new_value = [quality, True]
+        if self.props['SignalQuality'].value != new_value:
+            self.props['SignalQuality'] = Variant('(ub)', new_value)
+            self.emit_properties_changed({'SignalQuality': self.props['SignalQuality'].value})
+
