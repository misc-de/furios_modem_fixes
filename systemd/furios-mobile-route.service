[Unit]
Description=Keep a default route on the mobile data interface
Documentation=file:/usr/share/doc/furios-modem-fixes/README.md
# After, not Before: there is no bearer to ask about until ModemManager is up.
# The watcher copes with being started early anyway - it just sits on netlink
# until the bearer appears - but starting it in the right order keeps the
# journal honest about what happened when.
After=ModemManager.service NetworkManager.service
# Not Requires: on a phone with the modem switched off there is nothing to
# route and this should stay quiet rather than fail.
Wants=ModemManager.service

# The rate limit is off on purpose. With the backoff below, a supervisor that
# gives up is the expensive failure here, not one that keeps trying slowly:
# whatever it is watching goes unwatched until the next boot. The default
# limit could not fire anyway - five starts 5 s apart need 25 s and the
# window is ten - so this states the intent instead of leaving it to arithmetic.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/furios-mobile-route
# ip monitor should never exit. If it does, something took netlink away and a
# dead watcher would mean a phone that silently loses its fallback route.
Restart=always
RestartSec=5

# Backoff instead of giving up: RestartSteps stretches the delay from
# RestartSec up to RestartMaxDelaySec, so a permanent fault settles at one
# start every five minutes rather than one every 5 seconds, while a
# transient one still recovers on its own. Needs systemd 254 or newer; older
# versions ignore both keys with a warning and restart as before.
RestartSteps=5
RestartMaxDelaySec=300


# Everything this does is one ip-route write and some read-only mmcli calls.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
