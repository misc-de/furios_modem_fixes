[Unit]
Description=Keep mobile data up - the data call, and NetworkManager using it
Documentation=file:/usr/share/doc/furios-modem-fixes/README.md
# oFono is the one that has to be there: everything here is a call to it. Listed
# After ModemManager too so the journal reads in the order things happened, not
# because anything is asked of it.
#
# NetworkManager is deliberately NOT ordered against, although this now asks it
# things. It is asked through nmcli, one question at a time, and a missing
# answer means "not ours to act on" rather than an error - so the worst a race
# at boot can do is one quiet pass. An ordering edge would buy nothing and
# costs a way for the boot to go wrong.
After=ofono.service ModemManager.service
# Not Requires: with the modem stack switched off there is no context to
# supervise, and this should stay quiet rather than fail in a loop.
Wants=ofono.service

[Service]
Type=simple
ExecStart=/usr/bin/furios-mobile-context
# The supervisor going away silently would put the phone back to where it was:
# mobile data down until somebody notices. RestartSec is generous because the
# thing it supervises is a radio, and restarting fast helps nothing.
Restart=always
RestartSec=10

# Talks to oFono on the system bus and reads addresses. It changes the modem,
# never the filesystem or the network configuration.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
