[Unit]
Description=Keep the FuriOS modem fixes applied
Documentation=file:/usr/share/doc/furios-modem-fixes/README.md
# Before, not After: the patched files have to be on disk before ofono2mm
# imports them, otherwise the first boot after a package update comes up with
# a blind signal bar and a flapping data connection, and only the NEXT boot is
# healthy. ofono is listed too because radioInterface is read at its start.
Before=ofono.service ModemManager.service
# Not Requires: if the modem stack is not being started at all, there is
# nothing to fix and this should stay out of the way.
Wants=ofono.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A oneshot has no start timeout of its own, and oFono and ModemManager are
# ordered after this one. On a timeout they start anyway (Before=, not
# Requires=) - with the phone as shipped rather than not at all.
TimeoutStartSec=60
# --no-restart because systemd is starting those services right after this
# anyway. Restarting them from inside a unit they are ordered against is how
# you build a deadlock, and we have built that one before.
ExecStart=/usr/bin/modemctl boot --quiet --no-restart
# A modem that cannot be fixed must not keep the boot from finishing - and
# it does not, whatever this exits with: nothing Requires this unit, oFono and
# ModemManager are only ordered after it, and multi-user.target only Wants it.
# So the exit status decides one thing, whether "systemctl --failed" lists it.
# 1 is the everyday "something could not be done" (no SIM to ask, a bus that
# did not reload) and stays quiet. 5 is a patch that no longer fits the
# shipped ofono2mm: the repairs are out until somebody updates this package,
# no boot will change that, and it used to hide behind 1 - the phone ran
# without its repairs and every unit looked healthy. Not listed here, so the
# unit fails and says so; modemctl has already put the shipped file back.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
