#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2026 misc-de
# SPDX-License-Identifier: MIT
#
# Keeps the fixes to the FuriOS modem stack applied, and tells you honestly
# whether they are working.
#
# Most of them live in files that belong to the ofono2mm package, so every
# update of that package outdates them (they are diverted: the update lands
# beside ours as .distrib, and ours has to be made again). Two do not: the oFono binder config, and
# the DNS wiring that decides whether a name resolves once Wi-Fi is off. That is the whole reason this exists: apply is
# idempotent and safe to run from a boot unit and from an apt hook, and it
# refuses to touch a file whose patch no longer fits rather than mangling it.
set -u

# Every tool whose output is read here answers in one language: nmcli says
# "verbunden" instead of "connected", even with -t, on a system that has its
# German catalogue - FuriOS happens to ship without it today, pactl's is
# there and broke audioctl's status that way (4.10.2026). Nothing this runs
# shows text to anybody, so the whole script is set rather than each call.
export LC_ALL=C.UTF-8

VERSION=0.1.0
if [ "$(id -u)" -eq 0 ]; then
    for v in MODEMCTL_TARGET MODEMCTL_RADIO_CONF MODEMCTL_SHARE MODEMCTL_PATCHES \
             MODEMCTL_NM_CONF_D MODEMCTL_RESOLV MODEMCTL_NM_RESOLV \
             MODEMCTL_DBUS_CONF_D MODEMCTL_CBS_DB MODEMCTL_PROFILE \
             MODEMCTL_SYSTEMD_CONF_D MODEMCTL_SHELL_SYSTEM_UNIT MODEMCTL_SIM MODEMCTL_SIM_NAMES MODEMCTL_SIM_LOCK MODEMCTL_SIM_DROPIN MODEMCTL_NR MODEMCTL_NRPROBE \
             MODEMCTL_ORIGINAL MODEMCTL_MTK_PLUGIN MODEMCTL_MTK_BUILD MODEMCTL_DIVERT \
             MODEMCTL_WATCH_MARK MODEMCTL_DPKG_INFO; do
        if [ -n "${!v:-}" ]; then
            echo "refusing to honour $v as root - that would be an arbitrary-file patch" >&2
            exit 3
        fi
    done
fi

TARGET=${MODEMCTL_TARGET:-/usr/lib/ofono2mm/ofono2mm}
RADIO_CONF=${MODEMCTL_RADIO_CONF:-/etc/ofono/binder.d/radio-interface-binder.conf}
# The radio interface oFono speaks to the RIL. FuriOS ships 1.4 and that is
# where this stays. We had 1.6 here for a day: the plugin's name table ends at
# 1.5, an unrecognised value falls back to 1.2 WITHOUT A WORD, and from 1.3
# downwards the plugin strips NR out of the technology list. So the phone ran
# two interface versions below the one it shipped with and lost 5G from the
# settings, while the file claimed 1.6. Measured 13.9.: 1.5 does not bring
# this modem up at all ("Power request failed" every 30 s, oFono stuck at five
# interfaces), 1.4 comes up in ten seconds with twenty-six.
RADIO_INTERFACE_WANTED=1.4
FILES="utils mm_bearer mm_modem mm_modem_simple mm_modem_signal main"
# The six files are ofono2mm's, and they used to be patched where they lie.
# dpkg then saw its own files changed for as long as the repairs were on -
# "dpkg -V ofono2mm" never came back clean - and every apply left a .bak.<time>
# beside each of them. Now each one is diverted, the way the MTK plugin below
# is: dpkg keeps the shipped file as <file>.distrib (an update of ofono2mm
# writes its new version there, not over ours), and at the original path is a
# copy of ours, made from that .distrib by the patch. dpkg --verify follows
# the diversion and checks the .distrib, so it stays clean; revert takes the
# copy away and the diversion with it, which puts the shipped file back
# exactly. After an update the apt hook makes the copy again from the new
# .distrib - or, when the patch no longer fits it, puts the shipped file back.
# dpkg's checksums of the package's files, to make sure a file patched in
# place by an older version comes back to exactly the shipped bytes before it
# is handed to dpkg as the shipped one.
DPKG_INFO=${MODEMCTL_DPKG_INFO:-/var/lib/dpkg/info}

# The DNS half of defect 7. Both halves are needed: the drop-in stops
# NetworkManager calling the resolvconf that cannot work, and the symlink is
# what actually routes lookups at the resolver NetworkManager fills. NM will
# not replace a symlink pointing somewhere else, so that one is ours to set.
NM_CONF_D=${MODEMCTL_NM_CONF_D:-/etc/NetworkManager/conf.d}
RESOLV=${MODEMCTL_RESOLV:-/etc/resolv.conf}
DNS_DROPIN=99-furios-modem-resolvconf.conf
NM_RESOLV=${MODEMCTL_NM_RESOLV:-/run/NetworkManager/resolv.conf}

# Defect 13. ModemManager 1.24 added the CellBroadcast interface and a polkit
# action to guard it, but never an <allow> in its bus policy - so the <deny>
# at the top of that policy rejects every call before polkit is asked, and
# cellbroadcastd cannot hand the emergency alert channel list to the modem.
# Fixed upstream since, not in the 1.24.2 shipped here. Not an ofono2mm file,
# so a package update does not wipe it; it is here because nothing else on
# the phone will ever put it back.
DBUS_CONF_D=${MODEMCTL_DBUS_CONF_D:-/etc/dbus-1/system.d}
CB_DROPIN=furios-modem-cellbroadcast.conf
CB_IFACE=org.freedesktop.ModemManager1.Modem.CellBroadcast

# Defect 20. ModemManager.service is ofono2mm here, and ofono2mm's drop-in
# says Requires=ofono.service with no After=. Requires is not an ordering:
# systemd starts both at once, oFono sits in binder-wait for the radio HAL,
# and ofono2mm runs out of patience and takes the bus name with no modem
# behind it. phosh enumerates once, finds nothing, and the phone has grey
# bars until the shell is restarted. Not an ofono2mm file - it is a drop-in
# of our own on top of theirs, so an update of that package does not wipe it.
SYSTEMD_CONF_D=${MODEMCTL_SYSTEMD_CONF_D:-/etc/systemd/system}
ORDER_DROPIN=50-furios-modemmanager-name.conf
# The shell whose signal icon this is all about. The system unit, not the
# user one settle uses further down: modemctl runs as root from the boot unit
# too, where "systemctl --user" answers for nobody. Its start is a lower
# bound for the shell process - close enough to say whether the bus name was
# there first, which is the only question asked of it.
SHELL_SYSTEM_UNIT=${MODEMCTL_SHELL_SYSTEM_UNIT:-phosh.service}
# Defect 20 shipped this drop-in under another name, and with the opposite
# content: After=ofono.service. Defect 23 showed that ordering to be the
# cause of the grey signal icon, so the file was renamed rather than edited -
# but a phone that has the old one keeps obeying it, because a drop-in is
# whatever is in the directory. Every apply takes these out by name.
LEGACY_ORDER_DROPINS="50-furios-after-ofono.conf"
ORDER_UNIT=ModemManager.service

# Defect 25. An outgoing VoLTE call the network refuses at once (+ECPI 133,
# cause 63, while LTE registration flaps) stays "dialing" in oFono for ever:
# the MTK plugin ignores +ECPI 130, so the disconnect hits an id nobody knew,
# and the core synthesizes a call for the dial request that no event ever
# ends. Hangup has nothing to send; only restarting oFono clears it, and
# until then no other call can be made. The fix is C, in a FuriLabs package
# (ofono-binder-plugin-ext-mtk), so it is built on the phone from the exact
# commit that package was made from (mtk/build.sh, "modemctl mtk-build") and
# put in with dpkg-divert: the shipped plugin stays as .distrib, and an
# update of that package lands there instead of over ours. A build is only
# ever installed for the shipped file it was made from - built-for holds its
# sha256 - so after such an update the old build goes and the shipped plugin
# comes back until the apt hook has rebuilt. Not restarted from here: oFono
# picks it up at its next start, which at boot is after this runs.
# See upstream/ofono-binder-plugin-ext-mtk-1-phantom-dialing.md.
MTK_PLUGIN=${MODEMCTL_MTK_PLUGIN:-/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || echo aarch64-linux-gnu)/ofono/plugins/mtkbinderpluginext.so}
# Not under /var/lib/furios-modem-fixes: that one is 0700 (it holds the
# IMSI), and "modemctl status" run as the user - the app does exactly that -
# could not read built-for and called a perfectly good build outdated.
MTK_BUILD=${MODEMCTL_MTK_BUILD:-/var/lib/furios-modem-mtk}
MTK_PATCH_NAME=ofono-binder-plugin-ext-mtk-phantom-dialing.patch
DIVERT=${MODEMCTL_DIVERT:-dpkg-divert}

# Defect 14. The database cellbroadcastd takes its channel list from subscribes
# de and nl to EU-Alert level 2 with three of its four channels: 4371, 4384 and
# 4385, but not 4372. ETSI TS 102 900 assigns the level 1113/1114/1120/1121 -
# 4371, 4372, 4384, 4385 - and 4385 carries the local-language text of exactly
# the warning sent on 4372. Listing the translation of a warning but not the
# warning is not a choice anyone makes; us and il write the same pair as a
# range. Wrong upstream too, so no update brings the channel back.
# See upstream/mobile-broadband-provider-info-1-eu-alert-4372.md.
CBS_DB=${MODEMCTL_CBS_DB:-/usr/share/mobile-broadband-provider-info/serviceproviders.xml}
CBS_MARK='furios-modem-fixes: EU-Alert level 2 is 4371-4372'

# Walks only the <level type="extreme"> of the de and nl blocks. Anything else
# in this 363 KB file is none of our business, and it is rewritten often.
CBS_SCAN='
/<country code=/            { inc = ($0 ~ /code="(de|nl)"/) ? 1 : 0; lvl = 0 }
inc && /<level type="extreme">/ { lvl = 1 }
inc && /<\/level>/            { lvl = 0 }
inc && lvl && /<channels start="4371"/ {
    if ($0 ~ /end="4372"/) good++; else if ($0 ~ /end="4371"/) gap++; else odd++
}
END {
    if (odd > 0 || (good + gap) == 0) print "unknown"
    else if (gap > 0)                 print "missing"
    else                              print "applied"
}'

# Next to this script when run straight from the work tree; otherwise
# wherever it was installed. /usr/local first: install.sh puts it there, the
# package puts it in /usr, and if both have happened the one installed by hand
# is the one the person is looking at.
SHARE=${MODEMCTL_SHARE:-}
if [ -z "$SHARE" ]; then
    for d in "$(dirname "$(readlink -f "$0")")" /usr/local/share/furios-modem /usr/share/furios-modem; do
        [ -d "$d/patches" ] && { SHARE=$d; break; }
    done
    SHARE=${SHARE:-/usr/share/furios-modem}
fi
PATCHES=${MODEMCTL_PATCHES:-$SHARE/patches}

# The recorded choice: "fixed" or "shipped". Absent means fixed, so every
# phone that already has this package keeps behaving exactly as before.
#
# This is what makes "try" different from "set" in both directions. Reverting
# has always been temporary by accident - the boot unit put the patches back at
# the next start - and there was no way at all to say "shipped, and mean it".
# Now the file says which one the phone is supposed to be in, "modemctl boot"
# enforces it, and the boot unit and the apt hook call that instead of apply.
PROFILE_FILE=${MODEMCTL_PROFILE:-/etc/furios-modem-fixes.profile}
PROFILES="fixed shipped"
WATCHERS="furios-mobile-route.service furios-mobile-context.service"
# Whether the watchers may run: present while the phone is "fixed", for now.
# Both units are always enabled and start only with this file there
# (ConditionPathExists), so the profile is the one thing that decides - not
# the profile plus each unit's enablement, which could disagree with it. They
# did (4.10.2026): a phone recorded as "fixed" came out of an update with the
# data-call supervisor disabled, and the only way back was by hand. In /run,
# so every boot starts without it and "modemctl boot" puts it back from the
# recorded profile; a "try" ends with the reboot as before.
WATCH_MARK=${MODEMCTL_WATCH_MARK:-/run/furios-modem-fixes.watchers}

# Which SIM slot oFono talks to: "2", or nothing. Nothing recorded is slot 1,
# the one the phone shipped with, and then boot leaves the config alone.
SIM_FILE=${MODEMCTL_SIM:-/etc/furios-modem-fixes.sim}
# What each slot's card was called when it was last the active one.
SIM_NAMES=${MODEMCTL_SIM_NAMES:-/var/lib/furios-modem-fixes/sim-names}
# One switch at a time. Two overlapping ones restart oFono under each other,
# and the one that finishes last decides the slot - whichever that is.
SIM_LOCK=${MODEMCTL_SIM_LOCK:-/run/furios-modem-fixes.sim.lock}
# The slot choice itself: a drop-in of our own next to oFono's config, read
# after it (zz-) so its keys win. oFono's file belongs to a FuriLabs package
# (adaptation-radon-configs) and stays exactly as shipped - an update of it
# brings no conffile question, and the way back to slot 1 is deleting this.
SIM_DROPIN=${MODEMCTL_SIM_DROPIN:-$(dirname "$RADIO_CONF")/zz-furios-sim.conf}

# 5G: "on" when NR is to be allowed, nothing when not - off after installing,
# like everything else that changes what the radio does.
NR_FILE=${MODEMCTL_NR:-/etc/furios-modem-fixes.nr}
# The only way in that works (tools/5g/README.md): the RIL's own IRadio 1.6
# setAllowedNetworkTypesBitmap, on the HAL instance em1 that oFono leaves
# alone. oFono's plugin cannot send it, and an AT+ERAT from outside is
# overwritten by the RIL the next time it sets the network type.
NRPROBE=${MODEMCTL_NRPROBE:-}
if [ -z "$NRPROBE" ]; then
    for p in "$SHARE/tools/5g/nrprobe" "${SHARE%/share/furios-modem}/lib/furios-modem/nrprobe"; do
        [ -x "$p" ] && { NRPROBE=$p; break; }
    done
    NRPROBE=${NRPROBE:-/usr/lib/furios-modem/nrprobe}
fi
# RadioAccessFamily bit for NR (1 << RIL_RADIO_TECHNOLOGY_NR, which is 20).
RAF_NR=$((0x100000))

# What the phone had before the first change of ours, for everything that is
# not ours by name and whose original nobody else keeps: /etc/resolv.conf,
# oFono's TechnologyPreference, the cell broadcast channel list oFono stores
# per SIM, and whether ModemManager.service.d existed. The rule (30.9.2026):
# write down what was there before the FIRST change, never overwrite that on a
# second run or a reinstall, and put back exactly that - not what a default
# is assumed to be. Guessing is how revert once put our own resolv.conf link
# back, and how uninstall-cbs.sh came to hold a channel list measured on one
# phone and applied to every other.
#
# A record exists exactly as long as our change is in place: revert uses it
# and drops it, so the next apply writes down what the phone has THEN - which
# may be something its owner chose in between, and is the right thing to go
# back to next time. A value somebody changed after us is left alone and
# reported, and its record goes too: it no longer describes anything of ours.
#
# Root only (0700): one of the keys is the SIM's IMSI. The ofono2mm files are
# not here - their way back is the dpkg diversion, which keeps the shipped
# file as .distrib - and neither are the files that are ours by name.
ORIG_DIR=${MODEMCTL_ORIGINAL:-/var/lib/furios-modem-fixes/original}

# The warning channel lists cellbroadcastd ends up handing oFono once our bus
# policy lets it: after the policy alone (4372 lost), and after the
# serviceproviders.xml fix. The same two uninstall-cbs.sh knows. A list that
# is one of these is ours; any other one was chosen by somebody else.
CBS_OURS='919,4370-4371,4373-4392,4396-4397 919,4370-4392,4396-4397'

# What apply (and so boot) returns when a patch no longer fits the shipped
# file. Not 1: the boot unit takes 1 as success, and this must show.
EXIT_STALE=5

QUIET=0
NO_RESTART=0
PATCHES_ONLY=0
DO_RESTART=0
FORCE=0
IF_STALE=0

# Colour only when someone is watching. A boot unit's journal should not be
# full of escape codes.
if [ -t 1 ]; then
    C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_WARN=$'\033[33m'; C_B=$'\033[1m'; C_0=$'\033[0m'
else
    C_OK=; C_BAD=; C_WARN=; C_B=; C_0=
fi

say()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
ok()   { [ "$QUIET" -eq 1 ] || printf '  %sok%s    %s\n' "$C_OK" "$C_0" "$*"; }
skip() { [ "$QUIET" -eq 1 ] || printf '  --    %s\n' "$*"; }
warn() { printf '  %swarn%s  %s\n' "$C_WARN" "$C_0" "$*" >&2; }
bad()  { printf '  %sFAIL%s  %s\n' "$C_BAD" "$C_0" "$*" >&2; }
head_() { [ "$QUIET" -eq 1 ] || printf '\n%s== %s%s\n' "$C_B" "$*" "$C_0"; }

need_write() {
    local what=$1 problem=
    [ -w "$TARGET" ] || problem="$TARGET"
    if [ -e "$RADIO_CONF" ] && [ ! -w "$RADIO_CONF" ]; then
        problem="${problem:+$problem and }$RADIO_CONF"
    fi
    [ -z "$problem" ] && return 0

    echo "cannot write $problem" >&2
    [ "$(id -u)" -ne 0 ] && echo "try: sudo $0 $what" >&2
    exit 1
}

# Every patched file but one lives in the python module directory. main.py
# sits one level up, next to it, so ask rather than assume.
file_path() {
    case "$1" in
        main) echo "$TARGET/../main.py" ;;
        *)    echo "$TARGET/$1.py" ;;
    esac
}

# Where the package says the file is, for dpkg's checksum list.
pkg_path() {
    case "$1" in
        main) echo usr/lib/ofono2mm/main.py ;;
        *)    echo "usr/lib/ofono2mm/ofono2mm/$1.py" ;;
    esac
}

# The md5 dpkg has for the shipped file, or nothing when it has none.
dpkg_md5() {
    local list="$DPKG_INFO/ofono2mm.md5sums"
    [ -r "$list" ] || return 0
    awk -v p="$(pkg_path "$1")" '$2 == p { print $1; exit }' "$list"
}

# A scratch directory for working out states, made once and private (mktemp
# -d is 0700 with a name nobody can guess). Only ever read from and written
# to by this process; nothing in it is moved to a system path - files that
# replace a system file are made beside it.
SCRATCH=
scratch() {
    [ -n "$SCRATCH" ] && return 0
    SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/modemctl.XXXXXX") || { SCRATCH=; return 1; }
    trap 'rm -rf "$SCRATCH"' EXIT
}

# patch_to <in> <f> <out> [-R]: the file <in> with (or, -R, without) our
# patch for <f>, written to <out>. One file each, so patch is told the file
# rather than reading it from the patch header - and never touches <in>.
patch_to() {
    local in=$1 f=$2 out=$3; shift 3
    [ -f "$PATCHES/ofono2mm-$f.patch" ] && [ -f "$in" ] || return 1
    patch "$@" -s -f -r - -o "$out" "$in" < "$PATCHES/ofono2mm-$f.patch" >/dev/null 2>&1 \
        && return 0
    rm -f "$out"
    return 1
}

ofono2mm_diverted() {
    [ "$($DIVERT --truename "$1" 2>/dev/null)" = "$1.distrib" ]
}

# --- patch state ------------------------------------------------------------
#
# Not two answers. "Does not apply" is not the same as "already there", and
# treating them alike is how a half-patched file gets made worse.
#   applied   diverted, and ours is exactly the patch applied to the .distrib
#   inplace   patched where it lies, the way versions before 6.10.2026 did it
#             (counts as applied; apply moves it behind a diversion)
#   missing   the shipped file, unpatched - or diverted with a copy of ours
#             that no longer matches the .distrib under it (an update of
#             ofono2mm, or a patch of ours that changed)
#   stale     the patch does not fit the shipped file (upstream moved)
#   absent    no such file at all
patch_state() {
    local f=$1 path
    path=$(file_path "$f")
    [ -f "$PATCHES/ofono2mm-$f.patch" ] || { echo stale; return; }
    scratch || { echo stale; return; }
    if ofono2mm_diverted "$path"; then
        [ -f "$path.distrib" ] || { echo absent; return; }
        patch_to "$path.distrib" "$f" "$SCRATCH/$f.ours" || { echo stale; return; }
        if cmp -s "$SCRATCH/$f.ours" "$path"; then echo applied; else echo missing; fi
        return
    fi
    [ -f "$path" ] || { echo absent; return; }
    # In place only when taking the patch out and putting it back gives the
    # very same file - a reverse patch that merely applies is not proof.
    if patch_to "$path" "$f" "$SCRATCH/$f.shipped" -R \
       && patch_to "$SCRATCH/$f.shipped" "$f" "$SCRATCH/$f.ours" \
       && cmp -s "$SCRATCH/$f.ours" "$path"; then
        echo inplace
    elif patch_to "$path" "$f" "$SCRATCH/$f.ours"; then
        echo missing
    else
        echo stale
    fi
}

# Ours, in the sense of "the repair is in": applied, or in place.
patch_in() {
    case "$(patch_state "$1")" in applied|inplace) return 0 ;; esac
    return 1
}

# Our copy at the path, the shipped file as .distrib. Made beside the file and
# renamed into place, so ofono2mm never imports half of one. Starts from the
# .distrib when there is one, so after an update of ofono2mm this is also how
# the copy is made again.
ofono2mm_install() {
    local f=$1 path src tmp
    path=$(file_path "$f")
    if ofono2mm_diverted "$path"; then src="$path.distrib"; else src="$path"; fi
    tmp=$(mktemp "$path.furios.XXXXXX") || return 1
    if ! patch_to "$src" "$f" "$tmp"; then rm -f "$tmp"; return 1; fi
    { chmod --reference="$src" "$tmp" 2>/dev/null || chmod 644 "$tmp"; }
    chown --reference="$src" "$tmp" 2>/dev/null || true
    if ! ofono2mm_diverted "$path"; then
        $DIVERT --local --rename --divert "$path.distrib" --add "$path" >/dev/null 2>&1 \
            || { rm -f "$tmp"; return 1; }
    fi
    mv -f "$tmp" "$path" && return 0
    rm -f "$tmp"
    ofono2mm_undivert "$path"
    return 1
}

# The shipped file back at its path, and no diversion. Ours goes aside first
# - dpkg-divert --rename will not move the .distrib over an existing file -
# and comes back if dpkg-divert refuses, so a failure never leaves ofono2mm
# without the file.
ofono2mm_undivert() {
    local path=$1 aside="$1.furios-revert"
    ofono2mm_diverted "$path" || return 0
    if [ -e "$path" ]; then mv -f "$path" "$aside" || return 1; fi
    if $DIVERT --local --rename --divert "$path.distrib" --remove "$path" >/dev/null 2>&1; then
        rm -f "$aside"
        return 0
    fi
    [ -e "$aside" ] && mv -f "$aside" "$path"
    return 1
}

# From patched in place to diverted. The shipped bytes come from taking the
# patch out again, checked against dpkg's own checksum where dpkg has one -
# what goes to .distrib is what dpkg will verify and what revert will put
# back, so "nearly" is not good enough: a file that does not come back to
# dpkg's (somebody else edited it too) stays patched in place, and says so.
# Otherwise it is the shipped file for a moment, then diverted, and ours is
# made from the .distrib like any other time.
OFONO2MM_LEFT=0
ofono2mm_migrate() {
    local f=$1 path want tmp
    path=$(file_path "$f")
    tmp=$(mktemp "$path.furios.XXXXXX") || return 1
    patch_to "$path" "$f" "$tmp" -R || { rm -f "$tmp"; return 1; }
    want=$(dpkg_md5 "$f")
    if [ -n "$want" ] && [ "$(md5sum < "$tmp" | cut -d' ' -f1)" != "$want" ]; then
        rm -f "$tmp"
        return 2
    fi
    { chmod --reference="$path" "$tmp" 2>/dev/null || chmod 644 "$tmp"; }
    chown --reference="$path" "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$path" || { rm -f "$tmp"; return 1; }
    ofono2mm_install "$f" || return 1
    ofono2mm_drop_backups "$f"
    return 0
}

# The .bak.<time> copies versions before the diversions took at every apply.
# Each was the shipped file of its day; one that is byte for byte the .distrib
# is a copy of what dpkg now keeps itself, and goes. Any other is not known to
# be this version's shipped file and stays - OFONO2MM_LEFT counts them. Only
# our own names: the directory has other people's .bak files too.
ofono2mm_drop_backups() {
    local path b
    path=$(file_path "$1")
    OFONO2MM_LEFT=0
    ofono2mm_diverted "$path" && [ -f "$path.distrib" ] || return 0
    for b in "$path".bak.[0-9]*-[0-9]*; do
        [ -f "$b" ] || continue
        if cmp -s "$b" "$path.distrib"; then
            rm -f "$b"
        else
            OFONO2MM_LEFT=$((OFONO2MM_LEFT + 1))
        fi
    done
    return 0
}

# Patched in place, put back in place: the version before the diversions.
ofono2mm_revert_inplace() {
    local f=$1 path tmp
    path=$(file_path "$f")
    tmp=$(mktemp "$path.furios.XXXXXX") || return 1
    patch_to "$path" "$f" "$tmp" -R || { rm -f "$tmp"; return 1; }
    { chmod --reference="$path" "$tmp" 2>/dev/null || chmod 644 "$tmp"; }
    chown --reference="$path" "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$path" || { rm -f "$tmp"; return 1; }
}

# --- MTK plugin (defect 25) --------------------------------------------------
#
#   absent    no MTK plugin on this phone - nothing to fix
#   upstream  the shipped plugin already has the fix (mtk-build found it)
#   unbuilt   no build for the shipped plugin that is on disk now
#   missing   a build fits, but the shipped plugin is in place
#   applied   ours is in place, built for the shipped one under it
#   stale     ours is in place, but the package has changed underneath it
mtk_diverted() {
    [ "$($DIVERT --truename "$MTK_PLUGIN" 2>/dev/null)" = "$MTK_PLUGIN.distrib" ]
}

mtk_shipped() {
    if mtk_diverted; then echo "$MTK_PLUGIN.distrib"; else echo "$MTK_PLUGIN"; fi
}

mtk_state() {
    local stock hash built=0
    stock=$(mtk_shipped)
    [ -f "$stock" ] || { echo absent; return; }
    hash=$(sha256sum "$stock" | cut -d' ' -f1)
    if [ -f "$MTK_BUILD/upstream-fixed" ] && [ "$(cat "$MTK_BUILD/upstream-fixed")" = "$hash" ] \
       && ! mtk_diverted; then
        echo upstream; return
    fi
    [ -f "$MTK_BUILD/mtkbinderpluginext.so" ] && [ -f "$MTK_BUILD/built-for" ] \
        && [ "$(cat "$MTK_BUILD/built-for")" = "$hash" ] && built=1
    if mtk_diverted; then
        if [ "$built" -eq 0 ]; then echo stale
        elif cmp -s "$MTK_BUILD/mtkbinderpluginext.so" "$MTK_PLUGIN"; then echo applied
        else echo missing
        fi
    elif [ "$built" -eq 1 ]; then echo missing
    else echo unbuilt
    fi
}

# Puts the shipped plugin back and drops the diversion. Our file goes first:
# dpkg-divert --rename refuses to move the .distrib over an existing file.
mtk_undivert() {
    mtk_diverted || return 0
    rm -f "$MTK_PLUGIN" && $DIVERT --local --rename --divert "$MTK_PLUGIN.distrib" \
        --remove "$MTK_PLUGIN" >/dev/null
}

mtk_install() {
    local tmp
    if ! mtk_diverted; then
        $DIVERT --local --rename --divert "$MTK_PLUGIN.distrib" --add "$MTK_PLUGIN" \
            >/dev/null || return 1
    fi
    # Never a half-written plugin under oFono's nose: a copy next to it, then
    # one rename.
    tmp="$MTK_PLUGIN.furios-new"
    install -m644 "$MTK_BUILD/mtkbinderpluginext.so" "$tmp" && mv -f "$tmp" "$MTK_PLUGIN" \
        || { rm -f "$tmp"; mtk_undivert; return 1; }
}

cmd_mtk_build() {
    need_write mtk-build
    local builder="$SHARE/mtk/build.sh" rc state
    state=$(mtk_state)
    # The apt hook: rebuild what a package update has just outdated, and
    # nothing else - a phone that never had the fix does not get it from an
    # unrelated "apt upgrade".
    [ "$IF_STALE" = 1 ] && [ "$state" != stale ] && return 0
    head_ "MTK plugin"
    case "$state" in
        absent)   skip "no MTK plugin on this phone - nothing to build"; return 0 ;;
        applied)  [ "$FORCE" = 1 ] || { skip "already built and in place"; return 0; } ;;
        missing)  [ "$FORCE" = 1 ] || { skip "already built - \"modemctl apply\" puts it in"; return 0; } ;;
    esac
    [ -x "$builder" ] || { bad "$builder not found"; return 1; }
    "$builder" "$PATCHES/$MTK_PATCH_NAME" "$MTK_BUILD"
    rc=$?
    case "$rc" in
        0) ok "built - takes effect with \"modemctl apply\" and the next oFono start" ;;
        2) ok "the shipped plugin already has the fix" ;;
        *) bad "build failed - the shipped plugin stays"; return 1 ;;
    esac
}

# applied / missing / foreign / absent. "missing" is only the 1.6 an earlier
# version of this wrote (see RADIO_INTERFACE_WANTED). Any other value is
# FuriLabs' choice - a new vendor HAL may well need one - and is left alone:
# forcing 1.4 onto it would be the one change here that could cost the modem.
radio_state() {
    [ -f "$RADIO_CONF" ] || { echo absent; return; }
    local v
    v=$(sed -n 's/^radioInterface *= *\([0-9.]*\) *$/\1/p' "$RADIO_CONF" | head -1)
    case "$v" in
        "$RADIO_INTERFACE_WANTED") echo applied ;;
        1.6)                       echo missing ;;
        *)                         echo foreign ;;
    esac
}

#   applied / missing / absent
resolvconf_state() {
    local dropin="$NM_CONF_D/$DNS_DROPIN"
    [ -d "$NM_CONF_D" ] || { echo absent; return; }
    [ -f "$dropin" ] && grep -q '^rc-manager *= *symlink' "$dropin" || { echo missing; return; }
    # -f, so an absolute and a relative symlink to the same file both count.
    [ "$(readlink -f "$RESOLV" 2>/dev/null)" = "$NM_RESOLV" ] && echo applied || echo missing
}

#   applied / covered / missing / absent
# "covered" is the day this stops being ours: an ofono2mm that stops throwing
# Type=dbus away. Then the drop-in is dead weight and revert should take it.
ordering_state() {
    # The question is whether systemd knows what "ModemManager has started"
    # means. Upstream's unit is Type=dbus with BusName=..., so the unit is
    # started when the name is on the bus; ofono2mm's 10-ofono2mm.conf sets
    # Type=simple, and then it is started when the process exists - which on
    # 14.9. 14:50 was four and a half seconds too early (defect 23).
    # systemctl show answers for the unit as systemd assembled it, drop-ins
    # and all, which is the only reading that matters here.
    local dir="$SYSTEMD_CONF_D/$ORDER_UNIT.d"
    if [ ! -d "$SYSTEMD_CONF_D" ]; then
        echo absent; return
    fi
    if [ -f "$dir/$ORDER_DROPIN" ]; then
        echo applied; return
    fi
    # A machine that does not have the unit at all cannot be judged on it:
    # there is nothing to order, and a drop-in for a unit systemd never heard
    # of orders nothing. systemd says not-found for a unit it does not know,
    # and answers nothing at all when there is no systemctl to ask or no
    # systemd behind it - both are "cannot tell", and neither is a phone that
    # starts ModemManager too early.
    case "$(systemctl show "$ORDER_UNIT" -p LoadState --value 2>/dev/null)" in
        not-found|"") echo unknown; return ;;
    esac
    if [ "$(systemctl show "$ORDER_UNIT" -p Type --value 2>/dev/null)" = dbus ] \
       && [ "$(systemctl show "$ORDER_UNIT" -p BusName --value 2>/dev/null)" \
            = org.freedesktop.ModemManager1 ]; then
        echo covered; return
    fi
    echo missing
}

cellbroadcast_state() {
    [ -d "$DBUS_CONF_D" ] || { echo absent; return; }
    if [ -f "$DBUS_CONF_D/$CB_DROPIN" ] && grep -q "$CB_IFACE" "$DBUS_CONF_D/$CB_DROPIN"; then
        echo applied; return
    fi
    if grep -rl "$CB_IFACE" /usr/share/dbus-1/system.d "$DBUS_CONF_D" 2>/dev/null \
        | grep -qv "/$CB_DROPIN\$"; then
        echo covered; return
    fi
    echo missing
}

#   applied / missing / unknown / absent
# "unknown" is the important one: upstream rewrites this file constantly, and a
# block that no longer looks the way this expects is a block to leave alone.
cbs_db_state() {
    [ -f "$CBS_DB" ] || { echo absent; return; }
    awk "$CBS_SCAN" "$CBS_DB" 2>/dev/null || echo unknown
}

# Rewrites the one line, in place, through a temporary file beside the original
# - never through /tmp, which is world-writable and this runs as root. The
# result has to parse as XML before it replaces anything: a database that no
# longer loads takes the whole alert list with it, which is worse than the one
# missing channel this fixes.
cbs_db_edit() {
    local prog=$1 tmp rc=0
    tmp=$(mktemp "$CBS_DB.furios.XXXXXX") || return 1
    if awk -v mark="$CBS_MARK" "$prog" "$CBS_DB" > "$tmp" \
       && python3 -c 'import sys,xml.etree.ElementTree as E; E.parse(sys.argv[1])' "$tmp" 2>/dev/null \
       && [ -s "$tmp" ]; then
        # The mode and owner it had, not ones assumed: revert takes the one
        # line back out through here as well, and has to leave the file
        # exactly as the package shipped it - dpkg --verify included.
        { chmod --reference="$CBS_DB" "$tmp" 2>/dev/null || chmod 644 "$tmp"; } \
            && { chown --reference="$CBS_DB" "$tmp" 2>/dev/null || true; } \
            && mv -f "$tmp" "$CBS_DB" || rc=1
    else
        rc=1
    fi
    rm -f "$tmp"
    return $rc
}

# A call in progress is the one moment not to restart the modem stack. The
# apt hook runs after every package operation, including an unattended upgrade
# that happens to land while the phone is being used as a phone. The patched
# files are already on disk by then; the restart can wait for the next boot.
#
# The modem path is asked for, not assumed. /ril_0 is what this phone happens
# to call it, and every one of the four places that used to hardcode it would
# have gone quietly wrong on a phone that calls it something else - reporting
# "unreadable" for a modem that is answering perfectly.
#
# Asked once and remembered: unlike a context, the modem object is there for
# as long as oFono is.
MODEM_PATH=
modem_path() {
    [ -n "$MODEM_PATH" ] && { printf '%s' "$MODEM_PATH"; return 0; }
    MODEM_PATH=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono / \
        org.ofono.Manager.GetModems 2>/dev/null \
        | grep -oE '"/[^"]+"' | tr -d '"' | head -1)
    [ -n "$MODEM_PATH" ] || return 1
    printf '%s' "$MODEM_PATH"
}

# The context of a given type, by asking oFono which is which. The MMS context
# used to be addressed as /ril_0/context2, which is true today and is true by
# position rather than by meaning: contexts are numbered in the order they were
# added, so adding or removing one renumbers the rest and the check would
# silently start reading the wrong context's APN.
context_path() {
    local want=$1 modem paths p type
    modem=$(modem_path) || return 1
    paths=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono "$modem" \
        org.ofono.ConnectionManager.GetContexts 2>/dev/null \
        | grep -oE '"/[^"]+"' | tr -d '"')
    for p in $paths; do
        type=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono "$p" \
            org.ofono.ConnectionContext.GetProperties 2>/dev/null \
            | grep -A2 '"Type"' | grep -o 'string "[^"]*"' | tail -1 | cut -d'"' -f2)
        [ "$type" = "$want" ] && { printf '%s' "$p"; return 0; }
    done
    return 1
}

# Deliberately a second implementation of what furios-mobile-context also does:
# they are separate programs, installed separately, and a shared shell library
# would be a third installed artefact for eleven lines. What they must not
# differ in is --print-reply, which is the whole reason either of them is
# trustworthy.
call_in_progress() {
    local calls modem
    modem=$(modem_path) || return 1
    calls=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono "$modem" \
        org.ofono.VoiceCallManager.GetCalls 2>/dev/null) || return 1
    printf '%s' "$calls" | grep -q 'object path'
}

# --- SIM slot ---------------------------------------------------------------
#
# The phone has two SIM slots but one radio (DSDS), and FuriOS only ever gives
# oFono the first. Using both at once would mean a second modem that the
# shell, ModemManager's clients and every repair here know nothing about. So
# this chooses one: the config names the other slot and keeps the path
# /ril_0, and nothing above oFono can tell the difference.
#
# The binder plugin takes the HAL instance from the section name - [slot2]
# connects to IRadio/slot2 - and "slot" is the index oFono gives it. Measured
# 28.9.: with [slot2] oFono spoke to the second slot (empty then: SIM not
# present, the radio refused power with OPERATION_NOT_ALLOWED) and the phone
# came back on slot 1 with the file restored.
#
# IgnoreSlots is not decoration. /etc/ofono/binder.conf, which belongs to
# another package, has its own [slot1] with path /ril_0; without it that
# section would bring up a second modem at the same path.

# Android's properties, never waited on for long: this runs on the boot path.
gp() {
    timeout 3 getprop "$@" 2>/dev/null
}

# How many slots the hardware has. Android knows; without an answer, one.
sim_slot_count() {
    local n
    n=$(gp ro.telephony.sim.count)
    case "$n" in [1-9]) echo "$n" ;; *) echo 1 ;; esac
}

# Whether a card is in slot N (1-based). The MTK RIL reads the ICCID prefix of
# every card at start, whichever slot oFono is using - so this answers for the
# slot that is not active too, which oFono cannot.
sim_present() {
    [ -n "$(gp "gsm.sim.preiccid_$(( $1 - 1 ))")" ]
}

# The slot the config file points oFono at, or "unknown" when the file does not
# have exactly one [slotN] section. A file this does not understand is left
# alone - the same rule as a patch that no longer fits.
sim_conf_slot() {
    local found
    if [ -f "$SIM_DROPIN" ]; then
        found=$(sed -n 's/^\[slot\([0-9]\)\][[:space:]]*$/\1/p' "$SIM_DROPIN")
        case "$found" in [1-9]) echo "$found" ;; *) echo unknown ;; esac
        return
    fi
    [ -f "$RADIO_CONF" ] || { echo unknown; return; }
    found=$(sed -n 's/^\[slot\([0-9]\)\][[:space:]]*$/\1/p' "$RADIO_CONF")
    case "$found" in [1-9]) echo "$found" ;; *) echo unknown ;; esac
}

# The slot oFono's own file names. Not 1 only on a phone an earlier version of
# this switched by editing that file directly.
sim_shipped_slot() {
    [ -f "$RADIO_CONF" ] || { echo unknown; return; }
    local found
    found=$(sed -n 's/^\[slot\([0-9]\)\][[:space:]]*$/\1/p' "$RADIO_CONF")
    case "$found" in [1-9]) echo "$found" ;; *) echo unknown ;; esac
}

# Write a file whole or not at all: a half-written oFono config is a phone
# without a modem.
write_atomic() {
    local target=$1 content=$2 tmp
    tmp=$(mktemp "$(dirname "$target")/.furios-sim.XXXXXX") || return 1
    printf '%s\n' "$content" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$target" \
        || { rm -f "$tmp"; return 1; }
}

# --- the original state -----------------------------------------------------
#
# Three kinds of record under ORIG_DIR, one per key:
#   <key>.path    a copy of the file as it was, cp -a - so a symlink stays a
#                 symlink with its target written exactly as it was
#   <key>.absent  there was nothing at that path
#   <key>.value   a property value, possibly empty (empty is an answer too)
# Never overwritten: orig_has says whether the first change was recorded
# already, and every orig_save_* returns early if so.
orig_has() {
    [ -e "$ORIG_DIR/$1.path" ] || [ -L "$ORIG_DIR/$1.path" ] \
        || [ -e "$ORIG_DIR/$1.absent" ] || [ -e "$ORIG_DIR/$1.value" ]
}

orig_dir() {
    [ -d "$ORIG_DIR" ] && return 0
    ( umask 077; mkdir -p "$ORIG_DIR" ) 2>/dev/null
}

# What is at PATH now, before a change. Fails (and says so) when it cannot be
# written down - the caller decides whether to go ahead without a record.
orig_save_path() {
    local key=$1 path=$2
    orig_has "$key" && return 0
    orig_dir || { warn "cannot record the original of $path in $ORIG_DIR"; return 1; }
    if [ -e "$path" ] || [ -L "$path" ]; then
        cp -a "$path" "$ORIG_DIR/$key.path" 2>/dev/null \
            || { warn "cannot record the original of $path in $ORIG_DIR"; return 1; }
    else
        : > "$ORIG_DIR/$key.absent" \
            || { warn "cannot record the original of $path in $ORIG_DIR"; return 1; }
    fi
}

orig_save_value() {
    local key=$1 value=$2
    orig_has "$key" && return 0
    orig_dir || { warn "cannot record the original $key in $ORIG_DIR"; return 1; }
    printf '%s' "$value" > "$ORIG_DIR/$key.value" \
        || { warn "cannot record the original $key in $ORIG_DIR"; return 1; }
    chmod 600 "$ORIG_DIR/$key.value" 2>/dev/null || true
}

orig_value() {
    [ -e "$ORIG_DIR/$1.value" ] || return 1
    cat "$ORIG_DIR/$1.value"
}

# Put PATH back exactly as recorded: the copy, or nothing at all.
orig_restore_path() {
    local key=$1 path=$2
    if [ -e "$ORIG_DIR/$key.absent" ]; then
        rm -f "$path"
    elif [ -e "$ORIG_DIR/$key.path" ] || [ -L "$ORIG_DIR/$key.path" ]; then
        rm -f "$path" && cp -a "$ORIG_DIR/$key.path" "$path"
    else
        return 1
    fi
}

# What the record says, in words, for a report.
orig_describe() {
    local key=$1
    if [ -e "$ORIG_DIR/$key.absent" ]; then
        echo "nothing there"
    elif [ -L "$ORIG_DIR/$key.path" ]; then
        echo "a link to $(readlink "$ORIG_DIR/$key.path")"
    elif [ -e "$ORIG_DIR/$key.path" ]; then
        echo "a regular file:"
        sed 's/^/          | /' "$ORIG_DIR/$key.path"
    elif [ -e "$ORIG_DIR/$key.value" ]; then
        echo "\"$(cat "$ORIG_DIR/$key.value")\""
    fi
}

orig_forget() {
    rm -f "$ORIG_DIR/$1.path" "$ORIG_DIR/$1.absent" "$ORIG_DIR/$1.value"
    rmdir "$ORIG_DIR" 2>/dev/null || true
}

# --- the warning channel list oFono keeps -----------------------------------
#
# Nothing here ever sets it on the way in: with our bus policy and the 4372
# fix in place, cellbroadcastd hands its list to the modem through
# ModemManager, and oFono stores it per SIM in /var/lib/ofono/<IMSI>/cbs.
# Taking the policy away does not take the list back - on the shipped policy
# cellbroadcastd is refused and nobody writes it again. So the list that was
# there before our first change is recorded per SIM, and revert sets exactly
# that one back through oFono (never by editing the file: oFono rewrites it
# from memory).

# Every modem oFono has. Empty when oFono does not answer.
ofono_modems() {
    timeout 5 dbus-send --system --print-reply --dest=org.ofono / \
        org.ofono.Manager.GetModems 2>/dev/null \
        | sed -n 's/^ *object path "\(\/[^"]*\)"$/\1/p'
}

# The SIM in a modem, by its IMSI - the key oFono files the list under too.
# Digits only: it becomes part of a file name.
ofono_imsi() {
    timeout 5 dbus-send --system --print-reply --dest=org.ofono "$1" \
        org.ofono.SimManager.GetProperties 2>/dev/null \
        | grep -A1 '"SubscriberIdentity"' | sed -n 's/.*variant *string "\([0-9]*\)".*/\1/p' | head -1
}

# The channel list, which may be empty. Fails when there is no answer or no
# Topics in it - "empty" and "could not ask" are different records.
cbs_topics() {
    local reply
    reply=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono "$1" \
        org.ofono.CellBroadcast.GetProperties 2>/dev/null) || return 1
    printf '%s\n' "$reply" | grep -q '"Topics"' || return 1
    printf '%s\n' "$reply" | grep -A1 '"Topics"' \
        | sed -n 's/.*variant *string "\(.*\)".*/\1/p' | head -1
}

cbs_is_ours() {
    case " $CBS_OURS " in *" $1 "*) return 0 ;; esac
    return 1
}

# Before the first change that lets cellbroadcastd set the list. A list that
# already is one of ours is no original - a phone an older version set up -
# and is not written down; revert then says it has nothing to go back to.
#
# Returns 2 when oFono is not there to ask - at boot the unit runs before it.
# That is said, not hidden: apply goes ahead (the policy is ours by name, and
# the list only changes once cellbroadcastd acts), and revert then reports
# that it has no record to go back to.
cbs_record() {
    local m imsi topics modems
    modems=$(ofono_modems)
    [ -n "$modems" ] || return 2
    for m in $modems; do
        imsi=$(ofono_imsi "$m")
        [ -n "$imsi" ] || continue
        orig_has "cbs-topics-$imsi" && continue
        topics=$(cbs_topics "$m") || continue
        cbs_is_ours "$topics" && continue
        orig_save_value "cbs-topics-$imsi" "$topics" || return 1
    done
    return 0
}

# Back to the recorded list, for the SIM that is in the phone now. Returns 1
# only when oFono refused.
cbs_restore() {
    local m imsi topics rec any=0 rc=0
    for m in $(ofono_modems); do
        any=1
        imsi=$(ofono_imsi "$m")
        topics=$(cbs_topics "$m") || { skip "$m: oFono gave no channel list - left as it is"; continue; }
        if [ -z "$imsi" ] || ! orig_has "cbs-topics-$imsi"; then
            if cbs_is_ours "$topics"; then
                warn "no record of the channels before the first apply - left at $topics"
                warn "     (uninstall-cbs.sh falls back to the list measured on 13.9.2026)"
            else
                skip "warning channels are not ours to revert"
            fi
            continue
        fi
        rec=$(orig_value "cbs-topics-$imsi")
        if [ "$topics" = "$rec" ]; then
            skip "warning channels are what they were before: ${rec:-none}"
        elif cbs_is_ours "$topics"; then
            if timeout 10 dbus-send --system --print-reply --dest=org.ofono "$m" \
                   org.ofono.CellBroadcast.SetProperty string:Topics \
                   variant:string:"$rec" >/dev/null 2>&1; then
                ok "warning channels back to what they were before: ${rec:-none}"
            else
                bad "oFono did not take the channel list back - the record stays"
                rc=1
                continue
            fi
        else
            warn "the warning channels were changed since apply (now: $topics)"
            warn "     - left as they are. Before the first apply: ${rec:-none}"
        fi
        orig_forget "cbs-topics-$imsi"
    done
    [ "$any" = 1 ] || skip "oFono is not answering - warning channels left as they are"
    return $rc
}

sim_recorded() {
    local r
    r=$(cat "$SIM_FILE" 2>/dev/null)
    case "$r" in [2-9]) echo "$r" ;; *) echo 1 ;; esac
}

# --- SIM names --------------------------------------------------------------
#
# "SIM 1" and "SIM 2" say which slot, not which card. The name is easy for the
# card oFono uses - the SIM carries it - and not there at all for the other,
# because oFono only ever sees one slot. So: the live name for the active slot,
# the name remembered from when a slot was last active (for as long as the
# same card is in it), and otherwise the network code the RIL read from the
# card, looked up in the provider database - only when that gives exactly one
# name, since most codes are shared by a network and its resellers.

# Text from a SIM ends up in a program running as root and on the screen: one
# printable line, no longer than a name has to be.
sim_clean_name() {
    tr -cd '[:print:]' | cut -c1-32 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

sim_iccid_prefix() {
    gp "gsm.sim.preiccid_$(( $1 - 1 ))" | tr -cd '0-9'
}

# The card oFono is using right now: what it says it is, or failing that the
# network it is registered on.
sim_live_name() {
    local modem name
    modem=$(modem_path) || return 1
    name=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono "$modem" \
        org.ofono.SimManager.GetProperties 2>/dev/null \
        | grep -A1 '"ServiceProviderName"' | sed -n 's/.*variant *string "\(.*\)"$/\1/p')
    if [ -z "$name" ]; then
        name=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono "$modem" \
            org.ofono.NetworkRegistration.GetProperties 2>/dev/null \
            | grep -A1 '"Name"' | sed -n 's/.*variant *string "\(.*\)"$/\1/p')
    fi
    name=$(printf '%s' "$name" | sim_clean_name)
    [ -n "$name" ] && printf '%s' "$name"
}

# The RIL reads MCC+MNC from every unlocked card, whichever slot oFono uses:
# vendor.gsm.ril.uicc.mccmnc for slot 1, .1 for slot 2.
sim_db_name() {
    local n=$1 prop mccmnc
    prop=vendor.gsm.ril.uicc.mccmnc
    [ "$n" -gt 1 ] && prop="$prop.$(( n - 1 ))"
    mccmnc=$(gp "$prop" | tr -cd '0-9')
    [ ${#mccmnc} -ge 5 ] && [ -f "$CBS_DB" ] || return 1
    awk -v mcc="${mccmnc:0:3}" -v mnc="${mccmnc:3}" '
        /<provider[ >]/ { inp = 1; name = ""; hit = 0 }
        inp && name == "" && /<name[ >]/ {
            name = $0
            sub(/.*<name[^>]*>/, "", name); sub(/<\/name>.*/, "", name)
            gsub(/&amp;/, "\\&", name)
        }
        inp && /<network-id/ && index($0, "mcc=\"" mcc "\"") && index($0, "mnc=\"" mnc "\"") { hit = 1 }
        /<\/provider>/ { if (hit && name != "") names[tolower(name)] = name; inp = 0 }
        END { for (k in names) { c++; last = names[k] } if (c == 1) print last }
    ' "$CBS_DB" | sim_clean_name
}

# Remembered per slot together with the card's ICCID prefix, so a card that
# was swapped does not keep the old one's name. Root only - the file is in
# /var/lib - and silently skipped otherwise: a name is a convenience.
sim_remember_name() {
    local n=$1 name=$2 prefix tmp
    [ -n "$name" ] || return 0
    prefix=$(sim_iccid_prefix "$n")
    mkdir -p "$(dirname "$SIM_NAMES")" 2>/dev/null || return 0
    tmp=$( { grep -v "^$n	" "$SIM_NAMES" 2>/dev/null; printf '%s\t%s\t%s\n' "$n" "$prefix" "$name"; } )
    printf '%s\n' "$tmp" > "$SIM_NAMES" 2>/dev/null || return 0
    chmod 644 "$SIM_NAMES" 2>/dev/null || true
}

sim_name() {
    local n=$1 active=$2 name prefix
    if [ "$n" = "$active" ]; then
        name=$(sim_live_name) && { printf '%s' "$name"; return 0; }
    fi
    prefix=$(sim_iccid_prefix "$n")
    if [ -n "$prefix" ] && [ -f "$SIM_NAMES" ]; then
        name=$(awk -F '\t' -v n="$n" -v p="$prefix" '$1 == n && $2 == p { print $3 }' "$SIM_NAMES" \
               | tail -1 | sim_clean_name)
        [ -n "$name" ] && { printf '%s' "$name"; return 0; }
    fi
    sim_db_name "$n"
}

# The config for slot N, on stdout. Slot 1 gives the file back as it shipped:
# no IgnoreSlots, [slot1], slot = 0 - so going to slot 2 and back leaves no
# trace.
sim_conf_render() {
    local n=$1 count
    count=$(sim_slot_count)
    grep -q '^ExpectSlots *=' "$RADIO_CONF" || return 1
    awk -v n="$n" -v count="$count" '
        /^\[Settings\]/           { sec = "settings"; print; next }
        /^\[slot[0-9]\][ \t]*$/   { sec = "slot"; print "[slot" n "]"; next }
        /^\[/                     { sec = "other"; print; next }
        sec == "settings" && /^IgnoreSlots *=/ { next }
        sec == "settings" && /^ExpectSlots *=/ {
            print "ExpectSlots = slot" n
            if (n != 1) {
                other = ""
                for (i = 1; i <= count; i++)
                    if (i != n) other = other (other == "" ? "" : ",") "slot" i
                print "IgnoreSlots = " other
            }
            next
        }
        sec == "slot" && /^slot *=/ { print "slot = " (n - 1); next }
        { print }
    ' "$RADIO_CONF"
}

# Restart oFono on the new slot and bring everything above it along. oFono
# comes back offline after a restart and nothing puts it online by itself;
# ModemManager (which is ofono2mm) and NetworkManager keep what they knew of
# the old modem - the same two repairs "settle" makes.
sim_restart_stack() {
    local modem i present restarted_at failed=0
    head_ "restart"
    if ! systemctl restart ofono; then
        bad "could not restart oFono"
        return 1
    fi
    ok "oFono restarted"

    present=false
    for i in $(seq 1 "${SIM_RESTART_WAIT:-20}"); do
        sleep 2
        MODEM_PATH=
        modem=$(modem_path) || continue
        timeout 5 dbus-send --system --print-reply --dest=org.ofono "$modem" \
            org.ofono.SimManager.GetProperties 2>/dev/null \
            | grep -A1 '"Present"' | grep -q 'boolean true' && { present=true; break; }
    done
    if [ "$present" = true ]; then
        if timeout 10 dbus-send --system --print-reply --dest=org.ofono "$modem" \
               org.ofono.Modem.SetProperty string:Online variant:boolean:true >/dev/null 2>&1; then
            ok "SIM found, modem online"
        else
            bad "SIM found, but the modem did not go online"
            failed=1
        fi
    else
        warn "no SIM in this slot - the modem stays offline"
    fi

    restarted_at=$(date +%s)
    if systemctl restart ModemManager; then
        ok "ModemManager restarted (that is ofono2mm)"
        # Without a card the cellular device is "unavailable" for good, which
        # settle would read as stuck and answer by restarting NetworkManager -
        # a Wi-Fi blip for nothing. Measured 28.9. on the empty slot 2.
        if [ "$present" = true ]; then
            settle_networkmanager || failed=1
        else
            skip "no SIM - leaving NetworkManager alone"
        fi
        settle_shell "$restarted_at" || failed=1
    else
        bad "could not restart ModemManager"
        failed=1
    fi
    return $failed
}

# Point oFono at slot N. Returns 0 when it now says N, whether anything had
# to be written or not; SIM_CHANGED tells the caller which.
SIM_CHANGED=0
sim_conf_set() {
    local n=$1 cur shipped iface mpath other i count new
    SIM_CHANGED=0
    cur=$(sim_conf_slot)

    # An earlier version wrote the slot into oFono's own file. Put that file
    # back to slot 1 first; from here on the choice lives in the drop-in.
    shipped=$(sim_shipped_slot)
    if [ "$shipped" != 1 ] && [ "$shipped" != unknown ]; then
        new=$(sim_conf_render 1) && write_atomic "$RADIO_CONF" "$new" \
            || { bad "could not put $RADIO_CONF back to slot 1"; return 1; }
        SIM_CHANGED=1
    fi

    if [ "$n" = 1 ]; then
        if [ -e "$SIM_DROPIN" ]; then
            # Before us there was no such file, so slot 1 is no file - but
            # only one that still says it is ours. A hand-edited one is its
            # editor's, and deleting it would be deciding for them.
            if ! head -1 "$SIM_DROPIN" 2>/dev/null | grep -q '^# Written by modemctl sim'; then
                bad "$SIM_DROPIN was not written by modemctl - leaving it alone"
                return 1
            fi
            rm -f "$SIM_DROPIN" || { bad "could not remove $SIM_DROPIN"; return 1; }
            SIM_CHANGED=1
        fi
    else
        [ "$cur" = "$n" ] && [ "$SIM_CHANGED" = 0 ] && return 0
        # The interface version oFono's file gives its slot, so the other slot
        # speaks the same one. Only when it is missing, the shipped 1.4.
        iface=$(sed -n 's/^radioInterface *= *\([0-9.]*\) *$/\1/p' "$RADIO_CONF" 2>/dev/null | head -1)
        # The path oFono's file gives the modem - kept, so nothing above
        # oFono sees the switch. Without one there is nothing safe to write.
        mpath=$(sed -n 's/^path *= *\(\/[^ ]*\) *$/\1/p' "$RADIO_CONF" 2>/dev/null | head -1)
        [ -n "$mpath" ] || { bad "$RADIO_CONF names no modem path - leaving it alone"; return 1; }
        count=$(sim_slot_count)
        other=""
        for i in $(seq 1 "$count"); do
            [ "$i" = "$n" ] || other="${other:+$other,}slot$i"
        done
        write_atomic "$SIM_DROPIN" "# Written by modemctl sim - which SIM slot oFono uses.
# Delete this file to go back to slot 1, the one FuriOS ships with.
[Settings]
ExpectSlots = slot$n
IgnoreSlots = ${other:-slot1}

[slot$n]
path = $mpath
slot = $(( n - 1 ))
radioInterface = ${iface:-1.4}" || { bad "could not write $SIM_DROPIN"; return 1; }
        SIM_CHANGED=1
    fi
    if [ "$(sim_conf_slot)" != "$n" ]; then
        bad "wrote the SIM choice but oFono's config does not say slot $n - check by hand"
        return 1
    fi
    return 0
}

# Restarting ModemManager breaks mobile data until NetworkManager is
# restarted too. NetworkManager keeps the proxy for the modem object of the
# process that just died - it logs
#
#     modem with path /org/freedesktop/ModemManager1/Modem/0 already exists, ignoring
#
# and every Connect it then makes goes nowhere, so the device sits in
# "connecting (prepare)" for ever. Reproduced on every restart, not now and
# then, and it does not time out on its own. Disconnecting the device, taking
# it unmanaged and back, and re-activating the profile all fail; only
# restarting NetworkManager makes it look at the modem again.
settle_networkmanager() {
    local dev state i stuck=0
    for i in $(seq 1 12); do
        sleep 5
        # Looked up inside the loop on purpose. For a moment after the restart
        # the device is not in NetworkManager's list at all, and a single look
        # followed by "no device, nothing to do" is how this check did exactly
        # nothing the first time it ran for real - it returned before the
        # device came back, and mobile data stayed down.
        dev=$(nmcli -t -f DEVICE,TYPE d 2>/dev/null | sed -n 's/:gsm$//p' | head -1)
        [ -n "$dev" ] || continue

        state=$(nmcli -t -f DEVICE,STATE d 2>/dev/null | sed -n "s|^$dev:||p")
        case "$state" in
            *prepare*|*unavailable*|"") stuck=1 ;;
            *) ok "mobile data settled: $state"; return 0 ;;
        esac
    done

    # Never saw a cellular device: no SIM, no modem, nothing to settle. That
    # is not the failure this is here for.
    if [ "$stuck" -eq 0 ]; then
        skip "no cellular device in NetworkManager - nothing to settle"
        return 0
    fi

    warn "NetworkManager is still stuck on $dev - it kept a proxy for the"
    warn "ModemManager that just went away. Restarting it; Wi-Fi blips."
    if systemctl restart NetworkManager; then
        ok "NetworkManager restarted"
        return 0
    fi
    bad "could not restart NetworkManager - mobile data will stay down"
    return 1
}

# Restarting ModemManager also takes the mobile signal icon away, and that one
# does not come back on its own - not in an hour, not in five, on a stack that
# is otherwise perfectly healthy. Measured 14.9.
#
# The old process gives up the bus name a moment before the new one takes it.
# A GDBus client whose object manager notices the owner disappear re-sends
# GetManagedObjects to the unique name it last knew, and in that gap no
# <allow send_destination="org.freedesktop.ModemManager1"> rule can match any
# more - a rule keyed on a well-known name matches nothing while nobody owns
# it - so the bus answers with the catch-all deny:
#
#   Error calling GetManagedObjects() when name owner (null) for name
#   org.freedesktop.ModemManager1 came back: ...AccessDenied ... 1 matched
#   rules ... destination=":1.3188" (uid=0 comm="/usr/sbin/ofono2mm")
#
# and the client gives up for good. It is not a permission problem of ours:
# upstream lets anyone call ObjectManager, and the only policy that would
# cover this gap is one that allows the call to any destination whatsoever.
# The clients have no retry. So the honest repair is to find out who was hit
# and put back the one that the user can see.
SHELL_UNIT=mobi.phosh.Shell.service
# How far back "modemctl settle" looks when nobody told it when the restart
# was. Two minutes: long enough for a restart the user did by hand a moment
# ago, short enough not to drag in the one from this morning.
SETTLE_WINDOW=120

# Who was talking to ModemManager when it went away. One syslog identifier per
# line. Session services log to the system journal too, so root sees gsd-wwan
# and phosh here as well as chatty.
#
# The last filter is not cosmetic: a syslog identifier is whatever the program
# that logged chose to call itself, so it is text from outside, and it ends up
# in a message printed by a program running as root. Anything that is not a
# plain name is dropped rather than passed on.
clients_that_lost_modemmanager() {
    local since=$1 lines
    # The two shapes of the same moment, and deliberately not the error text.
    # GLib prints "Error calling GetManagedObjects() ... came back" only when
    # the call failed, whatever it failed with - AccessDenied when the name is
    # unowned at send time, ServiceUnknown a moment later when the old unique
    # name is gone, a timeout if it hangs. Matching on the error instead would
    # have missed two of the three, and matching on AccessDenied plus
    # "ModemManager" would have counted the cell broadcast denial of defect 13
    # - a different failure with a different fix, and claiming cellbroadcastd
    # "lost ModemManager" would send the next person after the wrong thing.
    #
    # Read first, filter second: a journalctl that is not there, or that
    # refuses, must not arrive at the other end of a pipe as "nobody lost
    # anything". That is the same answer a healthy phone gives, and it would
    # be the wrong one in the one case where somebody is looking for a fault.
    lines=$(journalctl --since "@$since" --no-pager -o short 2>/dev/null) || return 2
    printf '%s\n' "$lines" \
        | grep -E 'Error calling GetManagedObjects\(\) when name owner .* for name org\.freedesktop\.ModemManager1 came back|Error creating ModemManager:' \
        | awk '{print $5}' \
        | sed -E 's/\[[0-9]+\]:?$//; s/:$//' \
        | grep -E '^[A-Za-z][A-Za-z0-9._-]*$' \
        | sort -u
}

# When the shell that is running now started, in seconds since the epoch. A
# shell younger than the restart cannot still be suffering from it, and saying
# otherwise turns this into a command that nags for ever about a fault that was
# repaired an hour ago.
shell_started_at() {
    local pid stamp
    pid=$(pgrep -x phosh 2>/dev/null | head -1)
    [ -n "$pid" ] || return 1
    stamp=$(ps -o lstart= -p "$pid" 2>/dev/null)
    [ -n "$stamp" ] || return 1
    date -d "$stamp" +%s 2>/dev/null
}

settle_shell() {
    local since=$1 clients shell_hit= others= shell_age
    if ! clients=$(clients_that_lost_modemmanager "$since"); then
        warn "cannot read the journal - no way to tell who lost ModemManager"
        warn "if the signal icon is missing, the way back is in FINDINGS, defect 16"
        return 0
    fi
    if [ -z "$clients" ]; then
        # An empty journal is not proof that the shell has a modem. A client
        # only logs when a call FAILS, and a client that started while nobody
        # owned the name never makes one: GLib's name watcher has nothing to
        # fire on, so there is no call, no error, and no line. Measured 14.9.:
        # phosh started 19 s into the gap left by defect 18 and still had no
        # signal icon twenty minutes later, with a journal that said nothing.
        #
        # So ask the other question, which has an answer either way: is the
        # shell older than the ModemManager that is on the bus now? If it is,
        # its one early look may have found nobody.
        shell_age=$(shell_started_at) || shell_age=""
        if [ -z "$shell_age" ]; then
            skip "no client lost ModemManager, and no shell is running"
            return 0
        fi
        if [ "$shell_age" -gt "$since" ]; then
            ok "no client lost ModemManager, and the shell is younger than it"
            return 0
        fi
        warn "no client said it lost ModemManager - but the shell has been up"
        warn "since before this ModemManager started, and a shell that never"
        warn "found one says nothing at all. If the mobile signal icon is"
        warn "missing, that is why; nothing else is affected. The way back:"
        warn "    sudo systemctl restart $ORDER_UNIT"
        return 0
    fi
    while IFS= read -r c; do
        case "$c" in
            phosh|phoc|gsd-wwan) shell_hit=1 ;;
            *) others="${others:+$others }$c" ;;
        esac
    done <<< "$clients"

    if [ -n "$others" ]; then
        warn "also lost ModemManager and will not notice: $others"
        case " $others " in
            *" wireplumber "*)
                # Left alone on purpose: restarting wireplumber takes the
                # Bluetooth card away with it, which is a worse thing to do to
                # a phone than whatever wireplumber wanted from ModemManager.
                warn "wireplumber is left alone - restarting it costs the Bluetooth card" ;;
        esac
    fi

    if [ -n "$shell_hit" ]; then
        shell_age=$(shell_started_at) || shell_age=""
        if [ -n "$shell_age" ] && [ "$shell_age" -gt "$since" ]; then
            ok "the shell lost ModemManager back then and has been restarted since"
            return 0
        fi
    fi
    [ -n "$shell_hit" ] || { ok "the shell has ModemManager"; return 0; }

    warn "the shell lost ModemManager - the mobile signal icon is gone."
    warn "Everything else is fine: the modem is registered, data works, only"
    warn "the drawing of the icon is dead. The way back is a second, and it"
    warn "is not the shell (measured on the device 14.9., defect 23 - phosh"
    warn "picks the modem up again by itself when the name comes back):"
    warn "    sudo systemctl restart $ORDER_UNIT"
    return 0
}

# --- profiles ---------------------------------------------------------------

# What the phone is supposed to be. Absent means fixed: that is what every
# install before this existed was, and a missing file must not silently switch
# a phone to the shipped state.
recorded_profile() {
    local p
    # Nothing recorded is nothing chosen: after an installation every option
    # is off until somebody switches it on. It used to read "fixed", so an
    # installation put every repair in by itself.
    [ -f "$PROFILE_FILE" ] || { echo shipped; return; }
    p=$(head -1 "$PROFILE_FILE" 2>/dev/null | tr -d '[:space:]')
    case " $PROFILES " in
        *" $p "*) echo "$p" ;;
        # A file we cannot read is not a licence to decide for ourselves.
        *)        echo unknown ;;
    esac
}

# What the phone actually is. Three answers, because "half" is a real state -
# a patch that would not fit, an update caught halfway, somebody's experiment -
# and calling it either of the other two would be a lie in both directions.
#
#   fixed / shipped / mixed
actual_profile() {
    local f applied=0 total=0
    for f in $FILES; do
        total=$((total + 1))
        patch_in "$f" && applied=$((applied + 1))
    done
    # The configuration counts too, but only where it exists to be counted:
    # a phone with no NetworkManager or no alert database is not "half fixed"
    # for lacking what it never had.
    case "$(resolvconf_state)" in
        applied) applied=$((applied + 1)); total=$((total + 1)) ;;
        missing) total=$((total + 1)) ;;
    esac
    case "$(cellbroadcast_state)" in
        applied) applied=$((applied + 1)); total=$((total + 1)) ;;
        missing) total=$((total + 1)) ;;
        # "covered" is ModemManager allowing it on its own. Our drop-in is then
        # redundant, and whether it is there says nothing about which profile
        # the phone is in - counting it either way would make one of the two
        # answers permanently unreachable.
    esac
    case "$(cbs_db_state)" in
        applied) applied=$((applied + 1)); total=$((total + 1)) ;;
        missing) total=$((total + 1)) ;;
    esac
    # Only once there is a build to put in. Without one - not built yet, or
    # fixed upstream - its absence says nothing about the profile.
    case "$(mtk_state)" in
        applied) applied=$((applied + 1)); total=$((total + 1)) ;;
        missing|stale) total=$((total + 1)) ;;
    esac

    if   [ "$applied" -eq "$total" ]; then echo fixed
    elif [ "$applied" -eq 0 ];        then echo shipped
    else                                   echo mixed
    fi
}

# The watchers are part of the profile, not decoration: the route watcher is
# the whole of defect 7 and the supervisor is the whole of defect 9. A phone in
# the shipped state must not have them running, or it is not in the shipped
# state - for "try" as much as for "set" ("try shipped" once left both running
# on a phone that said "actual: shipped").
#
# Neither verb touches their enablement any more: that is always on, and the
# mark in /run says whether they may run (see WATCH_MARK). "set" differs from
# "try" only in the profile file, which "modemctl boot" turns into the mark at
# the next start.
watch_mark() {
    # watch_mark on|off - nothing else, so a mark is never half there
    if [ "$1" = on ]; then
        mkdir -p "$(dirname "$WATCH_MARK")" 2>/dev/null
        : > "$WATCH_MARK" 2>/dev/null || warn "could not write $WATCH_MARK"
    else
        rm -f "$WATCH_MARK" 2>/dev/null || warn "could not remove $WATCH_MARK"
    fi
}

set_watchers() {
    local want=$1 u
    watch_mark "$want"
    for u in $WATCHERS; do
        systemctl list-unit-files "$u" >/dev/null 2>&1 || continue
        if [ "$want" = on ]; then
            systemctl start "$u" >/dev/null 2>&1 || warn "could not start $u"
        else
            systemctl stop "$u" >/dev/null 2>&1 || warn "could not stop $u"
        fi
    done
}

# --- commands ---------------------------------------------------------------

# Once per apply, before the first of the two changes that make
# cellbroadcastd set a new warning channel list.
CBS_RECORDED=0
cbs_record_before_change() {
    [ "$CBS_RECORDED" = 1 ] && return 0
    CBS_RECORDED=1
    cbs_record
    case $? in
        0) ;;
        2) warn "oFono is not answering - the warning channel list could not be recorded"
           warn "     before this change; revert will say it has nothing to go back to" ;;
        *) warn "could not record the warning channel list in $ORIG_DIR" ;;
    esac
    return 0
}

cmd_apply() {
    need_write apply
    local ts restarted_at changed=0 touched=0 failed=0 stale=0
    ts=$(date +%Y%m%d-%H%M%S)

    head_ "ofono2mm"
    for f in $FILES; do
        case "$(patch_state "$f")" in
            applied) skip "$f.py already patched" ;;
            absent)  bad "$f.py not found - is ofono2mm installed?"; failed=1 ;;
            stale)
                # Diverted, the copy at the path is ours, made from an older
                # shipped file: an update of ofono2mm has landed under it and
                # the patch does not fit the new one. Our old code next to
                # the package's new files is the one thing worse than no
                # repair, so the shipped file goes back - what the update
                # would have done on its own before the diversions.
                if ofono2mm_diverted "$(file_path "$f")"; then
                    if ofono2mm_undivert "$(file_path "$f")"; then
                        changed=1
                        warn "$f.py: shipped file back in place"
                    else
                        bad "$f.py: could not put the shipped file back"
                    fi
                fi
                bad "$f.py: patch does not fit (upstream moved)"
                warn "     ready-made file in $SHARE/patched-files/$f.py - check by hand"
                stale=1
                failed=1 ;;
            inplace)
                # Patched where it lies, by a version before the diversions:
                # the same code, so nothing to restart - only dpkg gets its
                # file back, under .distrib.
                ofono2mm_migrate "$f"
                case $? in
                    0)  touched=1
                        ok "$f.py moved behind a dpkg diversion (shipped file: $f.py.distrib)"
                        [ "$OFONO2MM_LEFT" -eq 0 ] || warn "     $OFONO2MM_LEFT older backup(s) beside it are not this version's shipped file - kept" ;;
                    2)  bad "$f.py: taking the patch out does not give dpkg's file - left patched in place"
                        failed=1 ;;
                    *)  bad "$f.py: could not move it behind a diversion - left as it was"
                        failed=1 ;;
                esac ;;
            missing)
                if ofono2mm_install "$f"; then
                    ok "$f.py patched (shipped file: $f.py.distrib)"
                    changed=1
                    # A phone whose old package took its patches out on the
                    # way to this one still has that package's backups.
                    ofono2mm_drop_backups "$f"
                    [ "$OFONO2MM_LEFT" -eq 0 ] || warn "     $OFONO2MM_LEFT older backup(s) beside it are not this version's shipped file - kept"
                else
                    bad "$f.py: patch failed"
                    failed=1
                fi ;;
        esac
    done

    head_ "ofono radioInterface"
    case "$(radio_state)" in
        applied) skip "radioInterface already $RADIO_INTERFACE_WANTED" ;;
        foreign) skip "radioInterface is not ours to set - FuriLabs' value left alone" ;;
        absent)  bad "$RADIO_CONF not found"; failed=1 ;;
        missing)
            cp -a "$RADIO_CONF" "$RADIO_CONF.bak.$ts"
            sed -i "s/^radioInterface *= *[0-9.]*\$/radioInterface = \
$RADIO_INTERFACE_WANTED/" "$RADIO_CONF"
            if [ "$(radio_state)" = applied ]; then
                ok "radioInterface set to $RADIO_INTERFACE_WANTED (backup: \
$RADIO_CONF.bak.$ts)"
                changed=1
            else
                bad "could not set radioInterface - check by hand"
                failed=1
            fi ;;
    esac

    head_ "start order"
    for legacy in $LEGACY_ORDER_DROPINS; do
        [ -f "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$legacy" ] || continue
        if rm -f "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$legacy"; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            touched=1
            ok "$legacy removed - it ordered $ORDER_UNIT after ofono.service"
        else
            bad "could not remove $legacy"
            failed=1
        fi
    done
    # Only with our main.py. The shipped one gives the bus name up whenever
    # oFono is not there yet (defect 16), and under Type=dbus systemd stops
    # the unit when the name goes - with Restart=always that is a restart
    # loop every second. After an update whose main.py our patch no longer
    # fits, the drop-in goes too and the unit is as shipped.
    if ! patch_in main \
       && [ -f "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$ORDER_DROPIN" ]; then
        if rm -f "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$ORDER_DROPIN"; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            touched=1
            warn "main.py is not patched - start order drop-in removed, $ORDER_UNIT as shipped"
        fi
    fi
    if ! patch_in main; then
        skip "start order left as shipped - main.py is not patched"
    else
    case "$(ordering_state)" in
        covered) skip "$ORDER_UNIT already takes the bus name for systemd" ;;
        absent)  skip "$SYSTEMD_CONF_D not found - no systemd?" ;;
        unknown) skip "no $ORDER_UNIT here - nothing to order" ;;
        applied)
            # Same reasoning as the cell broadcast policy: present and correct
            # are different questions, and a phone that already has an older
            # copy of this file would otherwise never get a correction to it.
            if [ -f "$SHARE/systemd/$ORDER_DROPIN" ] \
               && ! cmp -s "$SHARE/systemd/$ORDER_DROPIN" \
                           "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$ORDER_DROPIN"; then
                if install -m644 "$SHARE/systemd/$ORDER_DROPIN" \
                        "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$ORDER_DROPIN"; then
                    systemctl daemon-reload >/dev/null 2>&1 || true
                    touched=1
                    ok "start order drop-in updated"
                else
                    bad "could not update $ORDER_DROPIN"
                    failed=1
                fi
            else
                skip "$ORDER_UNIT already answers to the bus name"
            fi ;;
        missing)
            if [ ! -f "$SHARE/systemd/$ORDER_DROPIN" ]; then
                bad "$ORDER_DROPIN not found in $SHARE/systemd"
                failed=1
            elif orig_save_value mm-service-d \
                     "$([ -d "$SYSTEMD_CONF_D/$ORDER_UNIT.d" ] && echo present || echo absent)" \
                 && mkdir -p "$SYSTEMD_CONF_D/$ORDER_UNIT.d" \
                 && install -m644 "$SHARE/systemd/$ORDER_DROPIN" \
                            "$SYSTEMD_CONF_D/$ORDER_UNIT.d/$ORDER_DROPIN"; then
                systemctl daemon-reload >/dev/null 2>&1 || true
                touched=1
                ok "$ORDER_UNIT counts as started when the bus name is up"
                # Deliberately no restart. Restarting ModemManager is what
                # costs the signal icon in the first place (defect 16), and
                # the ordering is a boot-time question anyway: there is
                # nothing it can do for a phone that is already up.
                say "      (applies at the next boot)"
            else
                bad "could not write $SYSTEMD_CONF_D/$ORDER_UNIT.d/$ORDER_DROPIN"
                failed=1
            fi ;;
    esac
    fi

    head_ "DNS"
    case "$(resolvconf_state)" in
        applied) skip "resolv.conf already points at NetworkManager" ;;
        absent)  skip "$NM_CONF_D not found - NetworkManager not installed?" ;;
        missing)
            local dropin="$NM_CONF_D/$DNS_DROPIN" dns_ok=1
            if [ -f "$SHARE/networkmanager/$DNS_DROPIN" ]; then
                install -m644 "$SHARE/networkmanager/$DNS_DROPIN" "$dropin" || dns_ok=0
            else
                bad "$DNS_DROPIN not found in $SHARE/networkmanager"
                dns_ok=0
            fi
            # Record whatever is there now - as a symlink if that is what it
            # is, and "nothing" if nothing is - before the first change, and
            # never again while our link stands: revert puts back exactly
            # this. It used to be a .bak.<time> next to the file, one per
            # apply, and revert took "the newest that is not ours" - a guess
            # that once put our own link back (30.9.2026).
            # Not when it already is our link (only the drop-in was missing):
            # that is no original, and revert must never put it back. A phone
            # an older version set up is in exactly that state; revert says
            # so and falls back to the old backups.
            # No record, no change: a link revert cannot undo exactly is the
            # thing this rule exists to prevent.
            if [ "$dns_ok" -eq 1 ] \
               && [ "$(readlink -f "$RESOLV" 2>/dev/null)" != "$NM_RESOLV" ] \
               && ! orig_save_path resolv.conf "$RESOLV"; then
                bad "leaving $RESOLV alone - nothing to put it back from"
                rm -f "$dropin"
                dns_ok=0
                failed=1
            fi
            if [ "$dns_ok" -eq 1 ] && ln -sfn ../run/NetworkManager/resolv.conf "$RESOLV"; then
                if [ "$(resolvconf_state)" = applied ]; then
                    touched=1
                    ok "resolv.conf -> $NM_RESOLV (before: $(orig_describe resolv.conf | head -1))"
                    # Deliberately no reload here. rc-manager is only read when
                    # NetworkManager starts or is reloaded, and a reload makes
                    # oFono clear and re-activate the data context - which on a
                    # weak cell comes straight back as "data call status 65535"
                    # and leaves mobile data down. The symlink works at once;
                    # the drop-in can wait for the next reload or boot.
                    say "      (rc-manager applies at the next NetworkManager reload or boot)"
                else
                    bad "resolv.conf still does not point at NetworkManager"
                    failed=1
                fi
            else
                [ "$dns_ok" -eq 1 ] && bad "could not write $RESOLV"
                failed=1
            fi ;;
    esac

    head_ "cell broadcast"
    case "$(cellbroadcast_state)" in
        applied)
            # Existing but not identical: a correction to the policy would
            # otherwise never reach a phone that already has an older copy,
            # because "is it there" and "is it right" are different questions.
            if [ -f "$SHARE/dbus/$CB_DROPIN" ] \
               && ! cmp -s "$SHARE/dbus/$CB_DROPIN" "$DBUS_CONF_D/$CB_DROPIN"; then
                if install -m644 "$SHARE/dbus/$CB_DROPIN" "$DBUS_CONF_D/$CB_DROPIN"; then
                    systemctl reload dbus >/dev/null 2>&1 || true
                    touched=1
                    ok "cell broadcast policy updated"
                else
                    bad "could not update $DBUS_CONF_D/$CB_DROPIN"
                    failed=1
                fi
            else
                skip "cell broadcast channels already reachable"
            fi ;;
        covered) skip "ModemManager's own policy allows $CB_IFACE now" ;;
        absent)  skip "$DBUS_CONF_D not found - no system bus?" ;;
        missing)
            cbs_record_before_change
            if [ ! -f "$SHARE/dbus/$CB_DROPIN" ]; then
                bad "$CB_DROPIN not found in $SHARE/dbus"
                failed=1
            elif install -m644 "$SHARE/dbus/$CB_DROPIN" "$DBUS_CONF_D/$CB_DROPIN" \
                 && [ "$(cellbroadcast_state)" = applied ]; then
                # A reload, never a restart: restarting the system bus takes
                # every service on it down with it. dbus re-reads system.d on
                # SIGHUP and the new rule is live immediately.
                if systemctl reload dbus >/dev/null 2>&1; then
                    touched=1
                    ok "cell broadcast channel list reachable for group radio"
                else
                    touched=1
                    ok "$CB_DROPIN installed"
                    say "      (applies at the next dbus reload or boot)"
                fi
            else
                bad "could not write $DBUS_CONF_D/$CB_DROPIN"
                failed=1
            fi ;;
    esac

    head_ "alert channel database"
    case "$(cbs_db_state)" in
        applied) skip "EU-Alert level 2 already lists 4372" ;;
        absent)  skip "$(basename "$CBS_DB") not installed" ;;
        unknown) warn "the de/nl alert channel block does not look the way this
      expects - leaving $(basename "$CBS_DB") alone" ;;
        missing)
            cbs_record_before_change
            if cbs_db_edit '
/<country code=/            { inc = ($0 ~ /code="(de|nl)"/) ? 1 : 0; lvl = 0 }
inc && /<level type="extreme">/ { lvl = 1 }
inc && /<\/level>/            { lvl = 0 }
inc && lvl && /<channels start="4371" end="4371"\/>/ {
    sub(/end="4371"/, "end=\"4372\"")
    sub(/\/>/, "/><!-- " mark " -->")
}
{ print }' && [ "$(cbs_db_state)" = applied ]; then
                touched=1
                ok "EU-Alert level 2 completed with channel 4372"
                say "      (cellbroadcastd hands the list to the modem at its next start)"
            else
                bad "could not add channel 4372 to $(basename "$CBS_DB")"
                failed=1
            fi ;;
    esac

    head_ "MTK plugin"
    case "$(mtk_state)" in
        absent)   skip "no MTK plugin on this phone" ;;
        upstream) skip "the shipped plugin already has the fix" ;;
        applied)  skip "MTK plugin already ours" ;;
        unbuilt)  skip "MTK plugin not built yet - run: modemctl mtk-build" ;;
        stale)
            # The package changed under our build. An old build in front of a
            # newer oFono is the one thing here that could cost every call,
            # so the shipped plugin comes back until the apt hook rebuilds.
            if mtk_undivert; then
                warn "MTK plugin was updated - shipped one back until rebuilt (modemctl mtk-build)"
                touched=1
            else
                bad "could not put the shipped MTK plugin back"
                failed=1
            fi ;;
        missing)
            if mtk_install; then
                ok "MTK plugin with the dialing fix in place (shipped one: $(basename "$MTK_PLUGIN").distrib)"
                say "     takes effect at the next oFono start - a reboot, or: systemctl restart ofono"
                touched=1
            else
                bad "could not put the MTK plugin in place - shipped one left"
                failed=1
            fi ;;
    esac

    # Stale bytecode is not cosmetic: Python will happily run a .pyc from
    # before the patch if its timestamp still looks newer.
    [ "$changed" -eq 1 ] && rm -rf "$TARGET/__pycache__"

    if [ "$changed" -eq 1 ] && [ "$NO_RESTART" -eq 0 ] && call_in_progress; then
        head_ "restart"
        warn "a call is in progress - not restarting the modem stack now"
        warn "the patched files are on disk; they take effect at the next restart"
    elif [ "$changed" -eq 1 ] && [ "$NO_RESTART" -eq 0 ]; then
        head_ "restart"
        # ModemManager.service is ofono2mm here (drop-in 10-ofono2mm.conf);
        # there is no ofono2mm.service. ofono itself is deliberately NOT
        # restarted - that leaves the modem offline.
        restarted_at=$(date +%s)
        if systemctl restart ModemManager; then
            ok "ModemManager restarted (that is ofono2mm)"
            settle_networkmanager || failed=1
            settle_shell "$restarted_at" || failed=1
        else
            bad "could not restart ModemManager"
            failed=1
        fi
    elif [ "$changed" -eq 1 ]; then
        say ""
        say "Changed but not restarted. Apply with: systemctl restart ModemManager"
    elif [ "$touched" -eq 1 ]; then
        # Work that needed no restart of the modem stack - a symlink, a bus
        # policy. Saying "nothing to do" here would be a lie about work just
        # done, and the next person would go looking for why it had no effect.
        say ""
        say "Done - nothing here needs the modem stack restarted."
    else
        say ""
        say "Nothing to do - everything is already in place."
    fi

    # A patch that no longer fits is the one failure that needs a person: no
    # boot and no apt hook will ever make it fit. Its own exit code, so the
    # boot unit - which counts 1 as success, so that a phone without
    # NetworkManager or a SIM does not fail its boot - shows it in
    # "systemctl --failed" (see furios-modem-fixes.service).
    [ "$stale" -eq 1 ] && return "$EXIT_STALE"
    return $failed
}

# The newest backup of resolv.conf that is not our own link to
# NetworkManager's file - what revert puts back. Empty when there is none.
resolv_backup() {
    local b
    for b in $(ls -1td "$RESOLV.bak."* 2>/dev/null); do
        [ "$(readlink -f "$b" 2>/dev/null)" = "$NM_RESOLV" ] && continue
        echo "$b"
        return 0
    done
}

cmd_revert() {
    need_write revert
    local restarted_at failed=0
    head_ "ofono2mm"
    local path
    for f in $FILES; do
        path=$(file_path "$f")
        # Diverted is ours whatever the copy holds: the shipped file is the
        # .distrib, and taking the diversion away puts exactly that back.
        if ofono2mm_diverted "$path"; then
            if ofono2mm_undivert "$path"; then
                ok "$f.py back to the shipped version"
            else
                bad "$f.py: could not put the shipped file back"; failed=1
            fi
            continue
        fi
        case "$(patch_state "$f")" in
            inplace)
                if ofono2mm_revert_inplace "$f"; then
                    ok "$f.py back to the shipped version"
                else
                    bad "$f.py: could not revert"; failed=1
                fi ;;
            *) skip "$f.py is not ours to revert" ;;
        esac
    done
    rm -rf "$TARGET/__pycache__" "$TARGET/../__pycache__"

    # An upgrade wants exactly this much and no more: the Python files back to
    # what ofono2mm ships, while the patches that describe them are still the
    # ones on disk. Everything below is configuration the new version is about
    # to set again anyway, and undoing it in the middle of an upgrade is how a
    # half-finished one leaves the phone without its DNS wiring, without the
    # cell broadcast policy and without the alert channel.
    if [ "$PATCHES_ONLY" = 1 ]; then
        say ""
        say "ofono2mm's own code is back; configuration left alone."
        return $failed
    fi

    head_ "ofono radioInterface"
    # Nothing to undo: what we want here is what the package ships. This used
    # to put 1.6 back to 1.4; 1.6 was our mistake, not our fix.
    skip "radioInterface $RADIO_INTERFACE_WANTED is the shipped value"


    head_ "DNS"
    # Put back exactly what was there before, not what we assume was there.
    # That is the record apply took before its first change (see ORIG_DIR),
    # and only while the link is still ours: a resolv.conf somebody pointed
    # elsewhere since is theirs, and is left alone and reported.
    #
    # The drop-in is ours by name and goes either way - it was not there
    # before us, and leaving it would keep NetworkManager on rc-manager=symlink
    # for a phone that is supposed to be as shipped.
    local ours_now=0 back="" had_dropin=0
    [ "$(readlink -f "$RESOLV" 2>/dev/null)" = "$NM_RESOLV" ] && ours_now=1
    back=$(resolv_backup)
    if [ -f "$NM_CONF_D/$DNS_DROPIN" ]; then
        had_dropin=1
        rm -f "$NM_CONF_D/$DNS_DROPIN" && ok "$DNS_DROPIN removed"
    fi
    if orig_has resolv.conf; then
        if [ "$ours_now" = 1 ]; then
            if orig_restore_path resolv.conf "$RESOLV"; then
                ok "resolv.conf back to what it was before the first apply: $(orig_describe resolv.conf | head -1)"
                orig_forget resolv.conf
                warn "with this undone, mobile data resolves no names once Wi-Fi is off"
            else
                bad "could not put $RESOLV back - the record stays in $ORIG_DIR"
                failed=1
            fi
        else
            warn "$RESOLV was changed since apply (now: $(readlink "$RESOLV" 2>/dev/null || echo 'a regular file'))"
            warn "     - left as it is. Before the first apply it was $(orig_describe resolv.conf)"
            orig_forget resolv.conf
        fi
    elif [ "$ours_now" = 1 ] && { [ "$had_dropin" = 1 ] || [ -n "$back" ]; }; then
        # No record: a phone an older version set up, which kept a
        # .bak.<time> per apply instead. The newest one that is not our own
        # link is the best there is - apply also backed up when only the
        # drop-in was missing and the link was already ours, and "the newest"
        # then put NetworkManager's resolv.conf straight back (found on
        # 30.9.2026). ls -1t is safe here only because nothing but root can
        # write this directory. Said out loud, because it is a guess. A link
        # with neither our drop-in nor a backup beside it was not made here.
        warn "no record of $RESOLV from before the first apply (an older version set this up)"
        if [ -n "$back" ]; then
            rm -f "$RESOLV" && cp -a "$back" "$RESOLV"
            ok "resolv.conf restored from the newest backup, $(basename "$back") - check it"
        elif [ -e /run/systemd/resolve/stub-resolv.conf ]; then
            ln -sfn ../run/systemd/resolve/stub-resolv.conf "$RESOLV"
            ok "resolv.conf set to the systemd-resolved stub - what FuriOS ships, assumed, not recorded"
        else
            warn "no backup and no resolved stub - leaving $RESOLV alone"
            warn "check it by hand, or DNS stays pointed at a resolver nobody fills"
        fi
        warn "with this undone, mobile data resolves no names once Wi-Fi is off"
    else
        skip "resolv.conf is not ours to revert"
    fi

    head_ "alert channel database"
    if [ -f "$CBS_DB" ] && grep -q "$CBS_MARK" "$CBS_DB" 2>/dev/null; then
        # Only ever our own line, found by the marker we left on it. Without
        # that, revert would undo an upstream that had fixed this itself.
        if cbs_db_edit '
$0 ~ mark {
    sub(/end="4372"/, "end=\"4371\"")
    sub(/<!--[^>]*EU-Alert level 2 is 4371-4372[^>]*-->/, "")
}
{ print }'; then
            ok "channel 4372 removed from $(basename "$CBS_DB")"
            warn "with this undone, EU-Alert level 2 is back to three of its four"
            warn "channels - see upstream/mobile-broadband-provider-info-1-*.md"
        else
            bad "could not restore $(basename "$CBS_DB")"
            failed=1
        fi
    else
        skip "no alert channel edit of ours to undo"
    fi

    head_ "start order"
    local mm_d="$SYSTEMD_CONF_D/$ORDER_UNIT.d" removed_order=0
    for legacy in $LEGACY_ORDER_DROPINS; do
        [ -f "$mm_d/$legacy" ] || continue
        rm -f "$mm_d/$legacy" && { ok "$legacy removed"; removed_order=1; }
    done
    if [ -f "$mm_d/$ORDER_DROPIN" ]; then
        rm -f "$mm_d/$ORDER_DROPIN"
        removed_order=1
    fi
    # The directory too, when apply made it - and only then. A
    # ModemManager.service.d that was there before us stays, even empty; one
    # we made goes, unless somebody put a file of their own in since.
    # Without a record (an older version applied) the old rule: gone if empty.
    case "$(orig_value mm-service-d 2>/dev/null)" in
        absent)
            if [ -d "$mm_d" ] && ! rmdir "$mm_d" 2>/dev/null; then
                warn "$mm_d holds files that are not ours - left in place"
            fi
            orig_forget mm-service-d ;;
        present)
            orig_forget mm-service-d ;;
        *)
            [ "$removed_order" = 1 ] && rmdir "$mm_d" 2>/dev/null ;;
    esac
    if [ "$removed_order" = 1 ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        ok "$ORDER_DROPIN removed"
        warn "with this undone, ofono2mm and oFono start at the same time again"
        warn "     - the boot that loses the race comes up with grey signal bars"
    else
        skip "no start order drop-in of ours to remove"
    fi

    head_ "cell broadcast"
    if [ -f "$DBUS_CONF_D/$CB_DROPIN" ]; then
        rm -f "$DBUS_CONF_D/$CB_DROPIN"
        systemctl reload dbus >/dev/null 2>&1 || true
        ok "$CB_DROPIN removed"
        warn "with this undone, emergency alert channels stay at whatever the"
        warn "modem happened to have - cellbroadcastd cannot set them"
    else
        skip "no cell broadcast drop-in of ours to remove"
    fi
    # The list cellbroadcastd set while the policy let it. Only once the
    # policy is gone, so nothing can set it again behind our back.
    cbs_restore || failed=1

    head_ "MTK plugin"
    if mtk_diverted; then
        if mtk_undivert; then
            ok "shipped MTK plugin back - takes effect at the next oFono start"
        else
            bad "could not put the shipped MTK plugin back"; failed=1
        fi
    else
        skip "MTK plugin is the shipped one"
    fi

    # Opt-in, because plain "modemctl revert" has always left the running
    # daemon alone and saying so - and a command that quietly started
    # restarting the modem stack would be a different command with the same
    # name. The profile switch passes --restart; nothing else does.
    if [ "$DO_RESTART" = 1 ]; then
        head_ "restart"
        if call_in_progress; then
            # revert never had this check because it never restarted anything.
            # The moment it does, it needs exactly the one apply has: taking
            # the modem stack away mid-sentence ends the call.
            warn "a call is in progress - not restarting the modem stack now"
            warn "the shipped files are on disk; they take effect at the next restart"
        else
            restarted_at=$(date +%s)
            if systemctl restart ModemManager; then
                ok "ModemManager restarted (that is ofono2mm)"
                settle_networkmanager || failed=1
                settle_shell "$restarted_at" || failed=1
            else
                bad "could not restart ModemManager"
                failed=1
            fi
        fi
        say ""
        say "Shipped state restored."
    else
        say ""
        say "Shipped state restored. Takes effect after:"
        say "    systemctl restart ModemManager"
    fi
    return $failed
}

# --- profile commands -------------------------------------------------------

cmd_profile() {
    local rec act
    rec=$(recorded_profile)
    act=$(actual_profile)
    printf 'recorded: %s\n' "$rec"
    printf 'actual:   %s\n' "$act"
    if [ "$rec" = unknown ]; then
        warn "$PROFILE_FILE holds something this does not understand - leaving it alone"
        return 1
    fi
    if [ "$act" = mixed ]; then
        warn "half of the repairs are in place and half are not"
        warn "     bring it back in line with: sudo modemctl set $rec"
        return 1
    fi
    if [ "$act" != "$rec" ]; then
        say ""
        say "This is a \"try\": the next boot returns to \"$rec\"."
    fi
    return 0
}

# For phones an earlier version set up. That one read "nothing recorded" as
# "fixed" and put the repairs in by itself, so a phone running them may have no
# file saying so - and with "nothing recorded" now meaning "off", the next boot
# would take them out of a phone that has been relying on them. Run by
# install.sh and the postinst, never by boot: after a "try fixed" boot must
# still go back to off, and a file written here would make the try permanent.
cmd_adopt() {
    local act
    [ -f "$PROFILE_FILE" ] && return 0
    act=$(actual_profile)
    [ "$act" = shipped ] && return 0
    need_write adopt
    printf 'fixed\n' > "$PROFILE_FILE" || { bad "could not record the profile in $PROFILE_FILE"; return 1; }
    chmod 644 "$PROFILE_FILE" 2>/dev/null || true
    say "The repairs were already in place (an earlier version switched them on"
    say "by itself) - recorded as \"fixed\" so they stay. Off: modemctl set shipped"
    return 0
}

# set = say what the phone should be, and make it so. try = make it so now and
# let the next boot put it back. The difference is one file.
cmd_switch() {
    local want=$1 remember=$2 rc=0
    case " $PROFILES " in
        *" $want "*) ;;
        *) echo "unknown profile: $want (known: $PROFILES)" >&2; exit 2 ;;
    esac
    need_write "$([ "$remember" = 1 ] && echo set || echo try) $want"

    if [ "$remember" = 1 ]; then
        printf '%s\n' "$want" > "$PROFILE_FILE" || {
            bad "could not record the profile in $PROFILE_FILE"; return 1; }
        chmod 644 "$PROFILE_FILE" 2>/dev/null || true
    fi

    case "$want" in
        fixed)
            cmd_apply || rc=1
            set_watchers on ;;
        shipped)
            # --no-restart still means what it says, here as everywhere else:
            # the boot unit and the tests both need a switch that writes files
            # and leaves the running stack alone.
            [ "$NO_RESTART" = 0 ] && DO_RESTART=1
            cmd_revert || rc=1
            set_watchers off
            warn "this is the state the phone shipped in, not a working one -"
            warn "     with Wi-Fi off it resolves no names and has no route out" ;;
    esac

    say ""
    if [ "$remember" = 1 ]; then
        say "Recorded: $want. This survives a reboot and a package update."
    else
        say "Not recorded: the next boot returns to \"$(recorded_profile)\"."
    fi
    return $rc
}

# Which SIM oFono uses. Without an argument: what there is, as "key: value"
# lines the app reads. With one: switch to that slot and remember it - a SIM
# choice that went back at the next boot would only be a surprise.
cmd_sim() {
    local want=${1:-} count active present="" i rc=0
    count=$(sim_slot_count)
    if [ -z "$want" ]; then
        active=$(sim_conf_slot)
        for i in $(seq 1 "$count"); do
            sim_present "$i" && present="${present:+$present }$i"
        done
        printf 'slots: %s\n' "$count"
        printf 'active: %s\n' "$active"
        printf 'recorded: %s\n' "$(sim_recorded)"
        printf 'present: %s\n' "${present:-none}"
        for i in $(seq 1 "$count"); do
            sim_present "$i" && printf 'name%s: %s\n' "$i" "$(sim_name "$i" "$active")"
        done
        return 0
    fi

    case "$want" in
        [1-9]) [ "$want" -le "$count" ] || {
                   echo "this phone has $count SIM slot(s), not $want" >&2; exit 2; } ;;
        *)     echo "usage: modemctl sim [1-$count]" >&2; exit 2 ;;
    esac
    # Only oFono's config directory has to be writable. need_write asks about
    # ofono2mm's files too, and a phone whose ofono2mm moved or went must still
    # be able to go back to slot 1.
    if [ ! -w "$(dirname "$SIM_DROPIN")" ]; then
        echo "cannot write $(dirname "$SIM_DROPIN")" >&2
        [ "$(id -u)" -ne 0 ] && echo "try: sudo $0 sim $want" >&2
        exit 1
    fi
    exec 9>"$SIM_LOCK" && flock -n 9 || {
        bad "another SIM switch is still running - try again when it is done"
        return 1
    }
    # Never to a slot without a card: that is a phone without mobile network
    # until somebody switches back. Seen 28.9. - the tray came out, slot 1 went
    # empty, and a switch to the now empty slot 2 went through. With
    # --no-restart it is only the file (uninstall puts slot 1 back that way,
    # card or not); --force is for testing a slot on purpose.
    # Slot 1 is exempt: it is the default the phone shipped with, and the way
    # back must not depend on a property a FuriLabs update could rename.
    if [ "$want" != 1 ] && [ "$NO_RESTART" -eq 0 ] && [ "$FORCE" -eq 0 ] \
       && ! sim_present "$want"; then
        bad "no card detected in slot $want - not switching"
        say "     (the tray holds both slots; is it pushed all the way in?)"
        return 1
    fi
    if [ "$NO_RESTART" -eq 0 ] && call_in_progress; then
        bad "a call is in progress - not switching the SIM now"
        return 1
    fi

    head_ "SIM slot"
    # The name of the card being left, while oFono can still read it.
    active=$(sim_conf_slot)
    [ "$active" != "$want" ] && [ "$NO_RESTART" -eq 0 ] && \
        sim_remember_name "$active" "$(sim_live_name)"
    sim_conf_set "$want" || return 1
    if [ "$want" = 1 ]; then
        rm -f "$SIM_FILE" || { bad "could not remove $SIM_FILE"; return 1; }
    else
        printf '%s\n' "$want" > "$SIM_FILE" || { bad "could not record the slot in $SIM_FILE"; return 1; }
        chmod 644 "$SIM_FILE" 2>/dev/null || true
    fi
    if [ "$SIM_CHANGED" -eq 0 ]; then
        skip "oFono already uses slot $want"
    else
        ok "oFono now uses slot $want"
        sim_present "$want" || warn "no SIM detected in slot $want"
        if [ "$NO_RESTART" -eq 0 ]; then
            sim_restart_stack || rc=1
            MODEM_PATH=
            sim_remember_name "$want" "$(sim_live_name)"
        else
            say "Changed but not restarted. Takes effect with: systemctl restart ofono ModemManager"
        fi
    fi
    say ""
    say "SIM $want recorded. This survives a reboot."
    return $rc
}

# The SIM half of boot: only when a slot other than 1 was chosen. Runs before
# oFono (the boot unit is ordered so), so writing the file is all it takes.
# An oFono package update that replaced the config lands here via the apt
# hook and gets the chosen slot back.
boot_sim() {
    local want
    [ -f "$SIM_FILE" ] || return 0
    want=$(sim_recorded)
    [ "$want" -le "$(sim_slot_count)" ] || {
        warn "recorded SIM slot $want does not exist here - leaving the config alone"; return 0; }
    sim_conf_set "$want" || return 0
    [ "$SIM_CHANGED" -eq 1 ] && say "SIM slot $want written back into $RADIO_CONF"
    return 0
}

# After the modem stack is up: a slot other than 1 that shows no card is a
# phone without mobile network - the card was moved, or an update changed how
# oFono reads its config. Back to slot 1, the shipped default, and the choice
# is forgotten so the next boot does not do it again. Run by
# furios-modem-sim-check.service; waits at most SIM_CHECK_WAIT seconds.
SIM_CHECK_WAIT=${SIM_CHECK_WAIT:-90}
cmd_sim_check() {
    local slot modem i
    [ -f "$SIM_FILE" ] || return 0
    slot=$(sim_conf_slot)
    [ "$slot" = 1 ] && return 0
    for i in $(seq 1 $(( SIM_CHECK_WAIT / 3 ))); do
        MODEM_PATH=
        if modem=$(modem_path) && timeout 5 dbus-send --system --print-reply \
               --dest=org.ofono "$modem" org.ofono.SimManager.GetProperties 2>/dev/null \
               | grep -A1 '"Present"' | grep -q 'boolean true'; then
            say "SIM slot $slot has a card - nothing to do"
            return 0
        fi
        sleep 3
    done
    warn "SIM slot $slot shows no card after ${SIM_CHECK_WAIT}s - back to slot 1"
    logger -t modemctl "SIM slot $slot showed no card - fell back to slot 1" 2>/dev/null || true
    sim_conf_set 1 || return 1
    rm -f "$SIM_FILE"
    [ "$NO_RESTART" -eq 0 ] && sim_restart_stack
    return 0
}

# --- 5G ---------------------------------------------------------------------
#
# FuriOS never gets NR on this phone: oFono asks for it through IRadio 1.4 and
# the modem answers Error 44 (see tools/5g/README.md), so the RIL keeps its
# allowed-types bitmap without NR and writes AT+ERAT=6 (G/U/L) at every start.
# Allowing NR through 1.6 is only half of it. Measured 29.9. in a 1&1 cell
# where a phone next to this one showed 5G: with NR allowed after the modem
# had registered, three minutes and 130 MB stayed on LTE; allowed and then
# registered afresh, oFono and ModemManager said nr within a download. The
# network learns what the phone can do when it registers, and keeps that.

# The side door of the slot oFono uses: em1 for slot 1, em2 for slot 2 (the
# vendor manifest pairs them so). Each has its own bitmap - read 29.9. with
# slot 1 active: em1 without NR as oFono left it, em2 with NR, untouched.
# Never slotN itself: that is oFono's, and a probe on slot2 once reset the
# modem (nrprobe refuses it anyway).
nr_probe() {
    local slot
    slot=$(sim_conf_slot)
    case "$slot" in [1-9]) ;; *) return 1 ;; esac
    NRPROBE_INSTANCE=em$slot timeout 15 "$NRPROBE" "$@"
}

# The allowed-types bitmap, as a number. Fails when the HAL does not answer.
nr_bitmap() {
    local v
    [ -x "$NRPROBE" ] || return 1
    v=$(nr_probe get 2>/dev/null \
        | sed -n 's/.*response 194 .* error 0 .* value \(-\{0,1\}[0-9]*\) .*/\1/p' | tail -1)
    [ -n "$v" ] || return 1
    printf '%s' "$v"
}

nr_allowed_now() {
    local v
    v=$(nr_bitmap) || { echo unknown; return 0; }
    [ $(( v & RAF_NR )) -ne 0 ] && echo yes || echo no
}

nr_recorded() {
    [ "$(cat "$NR_FILE" 2>/dev/null)" = on ] && echo on || echo off
}

# Put the NR bit to on or off and leave every other bit as the RIL has it.
# NR_CHANGED says whether anything had to be sent.
NR_CHANGED=0
nr_set() {
    local want=$1 cur new
    NR_CHANGED=0
    if [ ! -x "$NRPROBE" ]; then
        bad "nrprobe missing ($NRPROBE)"
        return 1
    fi
    cur=$(nr_bitmap) || { bad "the radio HAL did not say which networks it allows"; return 1; }
    if [ "$want" = on ]; then new=$(( cur | RAF_NR )); else new=$(( cur & ~RAF_NR )); fi
    if [ "$new" -eq "$cur" ]; then
        skip "the modem already has 5G $([ "$want" = on ] && echo allowed || echo "not allowed")"
        return 0
    fi
    nr_probe setallowed "$(printf '%#x' "$new")" >/dev/null 2>&1
    cur=$(nr_bitmap) || cur=-1
    if [ "$cur" -ne "$new" ]; then
        bad "the modem did not take $(printf '%#x' "$new") (it says $(printf '%#x' "$cur"))"
        return 1
    fi
    NR_CHANGED=1
    ok "5G $([ "$want" = on ] && echo allowed || echo "no longer allowed") ($(printf '%#x' "$new"))"
}

# oFono's own preference has to agree with the bitmap, or oFono fights it:
# whenever something makes it compare (a SIM or radio event - 29.9. 18:48,
# five hours after nrprobe), it finds NR it did not ask for, sends its own
# bitmap, gets Error 44, queries, finds NR again, and tries again two seconds
# later - forever (binder_network.c: set_pref_cb -> query -> check_pref_mode).
# 41054 log lines overnight. The mirror image of finding 1. So the preference
# follows the bitmap: nr with 5G, lte without. A preference of umts or gsm is
# someone's choice and is left alone.
nr_pref_now() {
    timeout 5 dbus-send --system --print-reply --dest=org.ofono "$(modem_path)" \
        org.ofono.RadioSettings.GetProperties 2>/dev/null \
        | grep -A1 TechnologyPreference | tail -1 | grep -o '"[a-z]*"$' | tr -d '"'
}

# The preference is not the modem's, it is oFono's setting, and oFono keeps
# it on disk: it outlives a reboot, an uninstall and the package. So what it
# was before the first "on" is recorded, and "off" puts exactly that back -
# as long as the "nr" is still ours. Without a record (5G switched on by an
# older version) "off" does what it always did, lte, and says it is assuming.
nr_pref() {
    local want=$1 cur target modem rec=""
    cur=$(nr_pref_now)
    if [ "$want" = on ] && [ -n "$cur" ]; then
        orig_save_value ofono-technology-preference "$cur" || true
    fi
    if [ "$want" = off ] && orig_has ofono-technology-preference; then
        rec=$(orig_value ofono-technology-preference)
        if [ -z "$cur" ]; then
            # oFono did not answer: keep the record for the next try.
            return 0
        elif [ "$cur" = "$rec" ]; then
            orig_forget ofono-technology-preference
            return 0
        elif [ "$cur" != nr ]; then
            warn "oFono's preference was changed since 5G was switched on (now: $cur)"
            warn "     - left as it is. Before: $rec"
            orig_forget ofono-technology-preference
            return 0
        fi
        target=$rec
    else
        case "$want:$cur" in
            on:lte)  target=nr ;;
            off:nr)  target=lte
                     warn "no record of oFono's preference from before 5G was switched on - assuming lte" ;;
            *)       return 0 ;;
        esac
    fi
    modem=$(modem_path) || return 1
    if timeout 10 dbus-send --system --print-reply --dest=org.ofono "$modem" \
            org.ofono.RadioSettings.SetProperty string:TechnologyPreference \
            variant:string:"$target" >/dev/null 2>&1; then
        if [ -n "$rec" ]; then
            ok "oFono's preference back to $target, what it was before 5G was switched on"
            orig_forget ofono-technology-preference
        else
            ok "oFono's preference: $target (matches the modem)"
        fi
    else
        bad "oFono kept its preference $cur - it will fight the modem (Error 44)"
        return 1
    fi
}

nr_registered() {
    local modem
    modem=$(modem_path) || return 1
    timeout 5 dbus-send --system --print-reply --dest=org.ofono "$modem" \
        org.ofono.NetworkRegistration.GetProperties 2>/dev/null \
        | grep -A1 '"Status"' | grep -qE '"(registered|roaming)"'
}

# Radio off and on again, the way flight mode does it, so the network hears
# what the phone can do now. Never during a call - that is the call.
# The data call drops with it; furios-mobile-context and NetworkManager bring
# it back, seen 29.9. (ccmni0 -> ccmni1 within the minute).
nr_reregister() {
    local modem i
    modem=$(modem_path) || { bad "no modem"; return 1; }
    if call_in_progress; then
        warn "a call is in progress - 5G follows at the next registration"
        return 2
    fi
    timeout 10 dbus-send --system --print-reply --dest=org.ofono "$modem" \
        org.ofono.Modem.SetProperty string:Online variant:boolean:false >/dev/null 2>&1
    sleep "${NR_OFF_SECONDS:-5}"
    if ! timeout 10 dbus-send --system --print-reply --dest=org.ofono "$modem" \
            org.ofono.Modem.SetProperty string:Online variant:boolean:true >/dev/null 2>&1; then
        bad "the radio did not come back on - flight mode off by hand"
        return 1
    fi
    for i in $(seq 1 "${NR_REG_WAIT:-30}"); do
        nr_registered && { ok "registered again"; return 0; }
        sleep 2
    done
    warn "radio is on, but not registered yet"
    return 0
}

cmd_nr() {
    local want=${1:-} rc=0
    if [ -z "$want" ]; then
        printf 'recorded: %s\n' "$(nr_recorded)"
        printf 'allowed: %s\n' "$(nr_allowed_now)"
        return 0
    fi
    case "$want" in
        on|off) ;;
        *) echo "usage: modemctl nr [on|off]" >&2; exit 2 ;;
    esac
    if [ ! -w "$(dirname "$NR_FILE")" ]; then
        echo "cannot write $(dirname "$NR_FILE")" >&2
        [ "$(id -u)" -ne 0 ] && echo "try: sudo $0 nr $want" >&2
        exit 1
    fi
    head_ "5G"
    if [ "$want" = on ]; then
        write_atomic "$NR_FILE" on || { bad "could not record the choice in $NR_FILE"; return 1; }
    else
        rm -f "$NR_FILE" || { bad "could not remove $NR_FILE"; return 1; }
    fi
    # What is and is not recorded here. The allowed-types bitmap needs no
    # record: the RIL writes its own at every start of oFono (AT+ERAT), so the
    # shipped one comes back by itself, and "off" only clears the one bit we
    # set. oFono's preference is on disk and is recorded (nr_pref). The one
    # thing that cannot go back is the modem's own nr_ps setting
    # (AT+EPSCONFIG, 1 = SIM1 may use NR data) - the modem refuses every
    # write to it with +CME ERROR: 50, so whatever it holds now stays. See
    # tools/5g/README.md.
    if [ "$NO_RESTART" -eq 0 ]; then
        nr_set "$want" || rc=1
        # "off" puts the preference back even when the HAL did not answer:
        # a preference left at nr is oFono fighting the modem (Error 44)
        # for as long as it runs, package or no package.
        if [ "$want" = off ] || [ "$rc" -eq 0 ]; then
            nr_pref "$want" || rc=1
        fi
        [ "$rc" -eq 0 ] && [ "$NR_CHANGED" -eq 1 ] && { nr_reregister || [ $? -eq 2 ] || rc=1; }
    else
        say "Recorded, the modem is left alone. Takes effect at the next boot."
    fi
    say ""
    say "5G $want recorded. This survives a reboot."
    return $rc
}

# After boot, from furios-modem-nr.service, and again whenever oFono restarts
# (the unit is PartOf it): oFono sets its own network type when it brings the
# modem up, and the RIL turns that into a bitmap without NR. So: wait until
# the modem is registered - by then oFono has said its piece - allow NR, and
# register once more. Then look again a little later, because the start is
# not always over when registration is.
NR_BOOT_WAIT=${NR_BOOT_WAIT:-180}
cmd_nr_boot() {
    local i try
    [ "$(nr_recorded)" = on ] || return 0
    for i in $(seq 1 $(( NR_BOOT_WAIT / 3 ))); do
        MODEM_PATH=
        nr_registered && break
        sleep 3
    done
    nr_registered || { warn "the modem did not register within ${NR_BOOT_WAIT}s - leaving 5G alone"; return 0; }
    sleep "${NR_SETTLE:-15}"
    local fresh=0
    for try in 1 2 3; do
        nr_set on || return 1
        nr_pref on || return 1
        # Only when NR had to be added: then the modem registered without it,
        # and the network will not ask again on its own. Already there means
        # it was there before registration - the day FuriOS allows NR by
        # itself, this is a no-op that leaves the radio alone.
        if [ "$NR_CHANGED" -eq 1 ]; then
            nr_reregister
            [ $? -eq 1 ] && return 1
            fresh=1
        fi
        sleep "${NR_RECHECK:-30}"
        if [ "$(nr_allowed_now)" = yes ]; then
            if [ "$fresh" -eq 1 ]; then
                logger -t modemctl "5G allowed, registered afresh" 2>/dev/null || true
            else
                logger -t modemctl "5G was already allowed - radio left alone" 2>/dev/null || true
            fi
            return 0
        fi
        warn "something took 5G away again - try $((try+1)) of 3"
    done
    bad "5G does not stay allowed"
    return 1
}

# What the boot unit and the apt hook run: make the phone match what was
# recorded, and nothing else. Deliberately does NOT enable or start units -
# enabling a service from a oneshot that other services are ordered against is
# how the audio stack once built a boot deadlock that survived the reboot. The
# watchers need neither: they are always enabled, ordered after this unit, and
# the mark written here decides whether they run.
cmd_boot() {
    local rec act
    boot_sim
    rec=$(recorded_profile)
    act=$(actual_profile)
    case "$rec" in
        fixed)   watch_mark on ;;
        shipped) watch_mark off ;;
    esac
    case "$rec" in
        unknown)
            warn "$PROFILE_FILE holds something this does not understand - doing nothing"
            return 0 ;;
        shipped)
            [ "$act" = shipped ] && { say "Recorded profile is shipped - nothing to undo."; return 0; }
            say "Recorded profile is shipped - taking the repairs back out."
            cmd_revert
            return $? ;;
        *)
            cmd_apply
            return $? ;;
    esac
}

# What to run after restarting ModemManager by hand. Both halves of that
# restart's damage are invisible until you go looking for them: NetworkManager
# sits in "prepare" for ever, and the shell drops the signal icon. Neither
# heals, and neither says anything.
# When ModemManager last started, in seconds since the epoch. systemd knows
# this exactly, and it is a better answer than "two minutes ago": somebody who
# notices the missing icon an hour after the restart should still get a look at
# the right window, not at an empty one.
modemmanager_started_at() {
    local t
    t=$(systemctl show ModemManager -p ActiveEnterTimestamp --value 2>/dev/null)
    [ -n "$t" ] || return 1
    date -d "$t" +%s 2>/dev/null
}

cmd_settle() {
    local failed=0 since started age
    if [ "$(id -u)" -ne 0 ]; then
        bad "settle needs root - it restarts services for other users"
        return 1
    fi
    head_ "settle"

    started=$(modemmanager_started_at) || started=""
    if [ -n "$started" ]; then
        since=$started
        age=$(( $(date +%s) - started ))
    else
        # No answer from systemd: fall back to a window wide enough for
        # "I just did it" and no wider.
        since=$(( $(date +%s) - SETTLE_WINDOW ))
        age=""
    fi

    # The NetworkManager half repairs one thing only: the proxy it kept for a
    # ModemManager that has just gone away. Without a recent restart there is
    # no such proxy, and running it anyway would restart NetworkManager - and
    # blink the Wi-Fi - because of a cellular device that is merely
    # unavailable, which is what airplane mode and a missing SIM look like.
    if [ -n "$age" ] && [ "$age" -gt "$SETTLE_WINDOW" ]; then
        skip "ModemManager has been up ${age}s - leaving NetworkManager alone"
    else
        settle_networkmanager || failed=1
    fi

    settle_shell "$since" || failed=1
    return $failed
}

cmd_status() {
    local bad_count=0
    head_ "patches"
    for f in $FILES; do
        case "$(patch_state "$f")" in
            applied) ok "$f.py" ;;
            # Working, and dpkg still sees its own file changed. The next
            # apply - every boot runs one - moves it behind a diversion.
            inplace) ok "$f.py (patched in place - the next apply diverts it)" ;;
            missing) bad "$f.py NOT patched"; bad_count=$((bad_count+1)) ;;
            stale)   bad "$f.py patch no longer fits"; bad_count=$((bad_count+1)) ;;
            absent)  bad "$f.py missing"; bad_count=$((bad_count+1)) ;;
        esac
    done
    case "$(mtk_state)" in
        applied)  ok "MTK plugin with the dialing fix" ;;
        upstream) skip "MTK plugin: fixed upstream" ;;
        absent)   ;;
        unbuilt)  skip "MTK plugin not built yet - modemctl mtk-build" ;;
        missing)  bad "MTK plugin built but not in place - modemctl apply"
                  bad_count=$((bad_count+1)) ;;
        stale)    bad "MTK plugin in place has no build for the shipped one under it - modemctl mtk-build"
                  bad_count=$((bad_count+1)) ;;
    esac
    case "$(radio_state)" in
        applied) ok "radioInterface = $RADIO_INTERFACE_WANTED" ;;
        foreign) skip "radioInterface as FuriLabs set it - not ours to change" ;;
        *)       bad "radioInterface not $RADIO_INTERFACE_WANTED"
                 bad_count=$((bad_count+1)) ;;
    esac

    local slot
    slot=$(sim_conf_slot)
    if [ "$slot" = unknown ]; then
        # Not a shape this writes - somebody else's config, and no claim to
        # make about it either way.
        skip "SIM slot: $(basename "$RADIO_CONF") has no single [slotN] section"
    elif [ "$(sim_slot_count)" -gt 1 ] || [ "$slot" != 1 ]; then
        if [ "$slot" = "$(sim_recorded)" ]; then
            ok "SIM slot $slot of $(sim_slot_count)"
        else
            bad "SIM slot $slot in use, $(sim_recorded) recorded"
            bad_count=$((bad_count+1))
        fi
    fi

    head_ "what the stack says"
    local q
    q=$(mmcli -m any 2>/dev/null | sed -n 's/.*signal quality: *//p')
    # "cached" before 0%, not after. ModemManager reports 0% (cached) for the
    # first seconds after every restart, before the first poll lands - calling
    # that a failure made a healthy package install look broken.
    case "$q" in
        "")        warn "signal quality unreadable - is ModemManager running?" ;;
        *cached*)  warn "signal quality $q - no reading yet, give it 15 s" ;;
        0%*)       bad "signal quality $q - the bar is blind again"; bad_count=$((bad_count+1)) ;;
        *)         ok "signal quality $q" ;;
    esac

    # Settings that live outside any package, so no update can undo them -
    # but they were part of the same repair and are worth seeing.
    local apn ipv6m mms_ctx
    mms_ctx=$(context_path mms)
    apn=$([ -n "$mms_ctx" ] && dbus-send --system --print-reply --dest=org.ofono "$mms_ctx" \
        org.ofono.ConnectionContext.GetProperties 2>/dev/null \
        | grep -A2 '"AccessPointName"' | grep -o 'string "[^"]*"' | tail -1 | cut -d'"' -f2)
    case "$apn" in
        "")    warn "MMS APN unreadable - is ofono running?" ;;
        mms)   bad "MMS APN is the placeholder 'mms' again - the mmsd loop is back"; bad_count=$((bad_count+1)) ;;
        *)     ok "MMS APN: $apn" ;;
    esac
    # oFono's preference against the modem's bitmap. oFono cannot put NR into
    # the bitmap itself (its IRadio 1.4 call gets Error 44), so the two must
    # agree or oFono retries every two seconds, forever: nr without NR in the
    # bitmap (finding 1, 13.9.), or lte with NR in it (30.9., after nrprobe).
    local pref allowed
    pref=$(nr_pref_now)
    allowed=$(nr_allowed_now)
    case "$pref:$allowed" in
        :*)       skip "radio technology preference unreadable" ;;
        nr:no)    bad "radio technology preference nr, but the modem does not allow NR - \
Error 44 every two seconds"; bad_count=$((bad_count+1)) ;;
        lte:yes)  bad "the modem allows NR, but oFono's preference is lte - \
Error 44 every two seconds (sudo modemctl nr on)"; bad_count=$((bad_count+1)) ;;
        *)        ok "radio technology preference: $pref" ;;
    esac

    # 5G is a choice, not a repair: off is fine. On and not allowed is not -
    # something took it away after nr-boot put it there.
    if [ "$(nr_recorded)" = on ]; then
        case "$(nr_allowed_now)" in
            yes) ok "5G switched on and allowed by the modem" ;;
            no)  bad "5G switched on, but the modem does not allow it - sudo modemctl nr on"
                 bad_count=$((bad_count+1)) ;;
            *)   warn "5G switched on, but the radio HAL did not answer" ;;
        esac
    else
        skip "5G not switched on (sudo modemctl nr on)"
    fi

    # The cellular profile by type, NOT the first one listed - that is the
    # Wi-Fi connection on any phone that has ever joined a network, and
    # checking its ipv6.method would say nothing about the modem.
    local gsmconn
    gsmconn=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null | sed -n 's/:gsm$//p' | head -1)
    ipv6m=$(nmcli -t connection show "$gsmconn" 2>/dev/null | sed -n 's/^ipv6\.method://p')
    case "$ipv6m" in
        "")        skip "no cellular NetworkManager profile found" ;;
        disabled)  ok "NetworkManager ipv6.method: disabled" ;;
        *)         warn "NetworkManager ipv6.method is '$ipv6m', expected 'disabled'" ;;
    esac

    case "$(resolvconf_state)" in
        applied) ok "resolv.conf -> NetworkManager (dnsmasq on 127.0.0.1)" ;;
        absent)  skip "no NetworkManager conf.d - cannot check DNS" ;;
        missing)
            bad "resolv.conf does not point at NetworkManager's resolver"
            bad "     with Wi-Fi off, routing works and no name resolves"
            bad_count=$((bad_count+1)) ;;
    esac

    case "$(ordering_state)" in
        applied|covered) ok "$ORDER_UNIT is started when its bus name is up" ;;
        absent)          skip "no $SYSTEMD_CONF_D - cannot check the unit type" ;;
        unknown)         skip "no $ORDER_UNIT here - cannot check the unit type" ;;
        missing)
            bad "$ORDER_UNIT is Type=simple: systemd calls it started at fork"
            bad "     it was 4.5 s early on 14.9. 14:50, and a failure to take"
            bad "     the name at all looks like a healthy service (defect 17)"
            bad_count=$((bad_count+1)) ;;
    esac

    # The drop-in is only half the answer. What correlates with the signal
    # icon on this boot is the order of two moments: the bus name appearing,
    # and the shell building the one ModemManager client it builds. On 14.9.
    # 14:50 the name was late and the phone came up with grey bars; on the
    # four boots before it the name was there first and the icon was fine.
    #
    # This is reported, not asserted. A client built exactly the way phosh
    # builds its own recovered from a late name in every timing that could be
    # constructed for it - 0 ms to 800 ms across its own construction, and a
    # name that appears with nothing behind it at all. The field says one
    # thing and the bench says another, and until that is settled this has no
    # business failing a phone (FINDINGS.md, defect 23).
    #
    # It also stays quiet once ModemManager has changed hands since: a
    # restart gives the shell another look, and on 14.9. 15:00 that is what
    # put the icon back on the device.
    local name_at shell_at shell_raw delta names_seen
    name_at=$(journalctl -b -u "$ORDER_UNIT" --no-pager -o short-unix 2>/dev/null \
              | grep -m1 'is ours' | cut -d' ' -f1 | cut -d. -f1)
    names_seen=$(journalctl -b -u "$ORDER_UNIT" --no-pager 2>/dev/null \
                 | grep -c 'is ours')
    # `date -d ""` is midnight this morning, not an error - so an unstarted
    # unit, or a systemctl that answers nothing, would read as "the name was
    # fifteen hours late". The raw value is checked before date ever sees it.
    shell_raw=$(systemctl show "$SHELL_SYSTEM_UNIT" -p ExecMainStartTimestamp \
                --value 2>/dev/null)
    case "$shell_raw" in
        ""|0|n/a) shell_at= ;;
        *)        shell_at=$(date -d "$shell_raw" +%s 2>/dev/null) ;;
    esac
    if [ -z "$name_at" ]; then
        warn "no 'is ours' line this boot - cannot say when the name appeared"
    elif [ -z "$shell_at" ]; then
        skip "$SHELL_SYSTEM_UNIT has no start time - cannot compare with the shell"
    else
        delta=$((shell_at - name_at))
        if [ "$delta" -ge 0 ]; then
            ok "bus name was up ${delta}s before $SHELL_SYSTEM_UNIT started"
        elif [ "${names_seen:-1}" -gt 1 ]; then
            ok "bus name was late at boot, but $ORDER_UNIT has restarted since"
        else
            warn "bus name appeared $(( -delta ))s after $SHELL_SYSTEM_UNIT started"
            warn "     if the mobile signal icon is missing, this is why - the"
            warn "     shell looked before anyone owned the name. Nothing else"
            warn "     is affected, and the way back costs a second:"
            warn "         sudo systemctl restart $ORDER_UNIT"
        fi
    fi

    # Reported as the channel count, not as "the file is there": the file is
    # only the permission. What matters is whether the list actually reached
    # the modem, and that is a question for oFono.
    case "$(cellbroadcast_state)" in
        applied|covered)
            local topics
            topics=$(timeout 5 dbus-send --system --print-reply --dest=org.ofono \
                "$(modem_path)" org.ofono.CellBroadcast.GetProperties 2>/dev/null \
                | grep -A1 '"Topics"' | sed -n 's/.*variant *string "\(.*\)".*/\1/p' | head -1)
            if [ -z "$topics" ]; then
                warn "cell broadcast policy in place, but oFono reports no channels"
            else
                local n
                n=$(awk -F, '{t=0; for(i=1;i<=NF;i++){ if(split($i,r,"-")==2) t+=r[2]-r[1]+1; else t++ } print t}' <<<"$topics")
                ok "cell broadcast: $n emergency channels set"
            fi ;;
        absent) skip "no $DBUS_CONF_D - cannot check cell broadcast" ;;
        missing)
            bad "cell broadcast channels cannot be set (bus policy denies it)"
            bad "     emergency alerts stay on whatever the modem defaulted to"
            bad_count=$((bad_count+1)) ;;
    esac

    case "$(cbs_db_state)" in
        applied) ok "EU-Alert level 2 complete (4372 present)" ;;
        absent)  skip "no alert channel database installed" ;;
        unknown) warn "alert channel database looks different than expected - not checked" ;;
        missing)
            bad "EU-Alert level 2 is missing channel 4372"
            bad "     'extreme, immediate, likely' warnings on that channel go unheard"
            bad_count=$((bad_count+1)) ;;
    esac

    # The mobile fallback route. Checked here because its absence is invisible
    # until the day Wi-Fi drops - and then the phone is simply offline, with
    # every part of the stack reporting itself healthy.
    #
    # Which interface mobile data is on is asked of furios-mobile-route, which
    # asks ModemManager. NOT of NetworkManager: NM keeps calling the cellular
    # device "connected" long after the bearer behind it is gone, and a check
    # built on that reports a missing route on a phone that simply has no
    # mobile data - a false alarm, told in the voice of a real one.
    local mobile_iface route_iface mobile_state tool=
    for t in "$SHARE/tools/furios-mobile-route" \
             /usr/local/bin/furios-mobile-route /usr/bin/furios-mobile-route; do
        [ -x "$t" ] && { tool=$t; break; }
    done
    # The metric comes from the tool too, for the same reason the interface
    # does. A copy of 1050 here would keep agreeing with it right up to the day
    # somebody overrides FURIOS_MOBILE_ROUTE_METRIC - and then this reports a
    # missing route on a phone whose route is exactly where it belongs.
    local metric=
    [ -n "$tool" ] && metric=$("$tool" --metric 2>/dev/null)
    # The one fallback, for a phone where the watcher is not installed at all.
    metric=${metric:-1050}
    route_iface=$(ip -4 route show default metric "$metric" 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)
    mobile_iface=$([ -n "$tool" ] && "$tool" --iface 2>/dev/null)
    mobile_state=$(systemctl is-enabled furios-mobile-route.service 2>/dev/null)
    if [ -z "$tool" ]; then
        skip "furios-mobile-route not installed - cannot check the fallback route"
    elif [ -z "$mobile_iface" ]; then
        skip "no mobile data connected, no fallback route to check"
    elif [ "$route_iface" = "$mobile_iface" ]; then
        ok "mobile default route: $mobile_iface"
    else
        bad "mobile data is on $mobile_iface but has NO default route - Wi-Fi off means offline"
        bad_count=$((bad_count+1))
    fi
    case "$mobile_state" in
        enabled) ok "furios-mobile-route.service enabled" ;;
        "")      skip "furios-mobile-route.service not installed" ;;
        *)       warn "furios-mobile-route.service is '$mobile_state' - the route will not survive a reboot" ;;
    esac

    # The other half of the same outage, and hidden the same way. When
    # NetworkManager is not holding the cellular connection, the phone still
    # has an address and - thanks to the route above - still has a way out;
    # what it does not have is a single DNS server, because the resolver is
    # filled from NetworkManager's IP configuration and there is none. Wi-Fi
    # covers that up completely until the moment it is gone.
    #
    # Asked only when there IS mobile data. NetworkManager calling the device
    # disconnected while the modem has no data call is not a fault, it is a
    # description.
    if [ -n "$mobile_iface" ] && command -v nmcli >/dev/null 2>&1; then
        local nm_line nm_dev nm_state
        nm_line=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | grep -m1 ':gsm:')
        nm_dev=${nm_line%%:gsm:*}
        nm_state=${nm_line#*:gsm:}
        case "$nm_state" in
            connected*|"") ;;
            *) warn "mobile data is up on $mobile_iface, but NetworkManager says '$nm_state'"
               warn "     - it holds no DNS servers for it; with Wi-Fi off nothing resolves"
               warn "     - furios-mobile-context repairs this; to do it now:"
               warn "       nmcli device connect $nm_dev" ;;
        esac
    fi

    local ctx_state
    ctx_state=$(systemctl is-enabled furios-mobile-context.service 2>/dev/null)
    case "$ctx_state" in
        enabled)
            # Enabled is the normal state in both profiles now; what differs
            # is whether it runs, and that follows the profile.
            if [ "$(recorded_profile)" != fixed ]; then
                ok "furios-mobile-context.service enabled, idle (repairs off)"
            elif [ -e "$WATCH_MARK" ] \
                 && systemctl is-active --quiet furios-mobile-context.service; then
                ok "furios-mobile-context.service running"
            else
                warn "furios-mobile-context.service is not running - a dropped data call stays dropped"
                warn "     switch the repairs off and on again in the app, or: sudo modemctl set fixed"
            fi ;;
        "")      skip "furios-mobile-context.service not installed" ;;
        *)       warn "furios-mobile-context.service is '$ctx_state' - installed by an older version; an update of this package enables it" ;;
    esac

    # A second thing activating the same context is not twice as good. Two of
    # them racing on one D-Bus property is how oFono ends up answering
    # SetProperty while doing nothing, which is the state this had to be dug
    # out of by hand.
    if [ "$ctx_state" = enabled ] && \
       [ "$(systemctl is-enabled furios-mobile-data.service 2>/dev/null)" = enabled ]; then
        warn "furios-mobile-data.service is enabled too - both activate the same"
        warn "     context. Keep one: 'systemctl disable --now furios-mobile-data'"
    fi

    say ""
    if [ "$bad_count" -eq 0 ]; then
        say "${C_OK}everything in place${C_0}"
    else
        say "${C_BAD}$bad_count problem(s)${C_0} - fix with: sudo modemctl apply"
    fi
    return $([ "$bad_count" -eq 0 ] && echo 0 || echo 1)
}

cmd_signal() {
    # NOT "exec a || exec b": a failed exec ends the shell outright, so the
    # fallback never runs. That gave exit 127 and no message at all when the
    # share directory was wrong.
    for t in "$SHARE/tools/furios-modem-signal" \
             /usr/local/bin/furios-modem-signal /usr/bin/furios-modem-signal; do
        [ -x "$t" ] && exec "$t" "$@"
    done
    echo "furios-modem-signal not found - is this installed?" >&2
    exit 1
}

cmd_check() {
    local failed=0
    cmd_status || failed=1

    head_ "loops in the last 10 minutes"
    # These are the two runaway loops the other fixes killed. Journald prints
    # every ofono line twice, hence the dedup.
    local n
    n=$(journalctl -u ofono --since "-10min" --no-pager 2>/dev/null \
        | grep -cE "Error 44|Unexpected data call|Activating context" || true)
    if [ "${n:-0}" -gt 20 ]; then
        bad "$n loop lines in 10 min - something is retrying hard again"
        failed=1
    else
        ok "${n:-0} loop lines (a handful is normal)"
    fi

    head_ "is the signal actually being polled"
    if [ "$(id -u)" -ne 0 ]; then
        skip "needs root - dbus-monitor cannot eavesdrop as a normal user"
        skip "and it fails SILENTLY, so an empty run proves nothing"
    else
        local calls
        calls=$(timeout 70 dbus-monitor --system \
            "type='method_call',interface='org.ofono.NetworkMonitor'" 2>/dev/null \
            | grep -c GetServingCellInformation || true)
        if [ "${calls:-0}" -ge 2 ]; then
            ok "${calls} cell info polls in 70 s (expected 2, every 30 s)"
        else
            bad "only ${calls:-0} polls in 70 s - the bar will not move"
            failed=1
        fi
    fi
    return $failed
}

usage() {
    cat <<USAGE
modemctl $VERSION - keeps the FuriOS modem fixes applied

  modemctl status          what is in place, and what the stack says
  modemctl profile         which profile is recorded, and which one is running
  modemctl set <profile>   switch and remember it
  modemctl try <profile>   switch until the next boot
  modemctl apply           apply everything that is missing (idempotent)
  modemctl revert          back to the shipped state
  modemctl check           status plus runtime checks (polling, loops)
  modemctl signal          what the radio really receives, cross-checked
  modemctl sim             SIM slots: how many, which is used, where a card is
  modemctl sim-check       after boot: back to slot 1 if the chosen slot
                           shows no card (furios-modem-sim-check.service)
  modemctl sim <n>         use the SIM in slot n and remember it (one at a
                           time - the phone has one radio for both slots);
                           refused for a slot without a card unless --force
  modemctl nr              5G: whether it is switched on, and whether the
                           modem allows it right now
  modemctl nr on|off       allow 5G (NR) or not, and remember it; the radio
                           registers afresh once, which drops data briefly
  modemctl nr-boot         after boot: allow 5G again if it is switched on
                           (furios-modem-nr.service)
  modemctl mtk-build       build oFono's MTK plugin with the fix for a refused
                           VoLTE call that stays "dialing" (needs network and
                           the -dev packages it names; --force rebuilds)
  modemctl boot            make the phone match the recorded profile
                           (used by the boot unit and the apt hook)
  modemctl adopt           record "fixed" if an earlier version put the
                           repairs in without recording it (installers)
  modemctl settle          after restarting ModemManager by hand: put
                           NetworkManager back in order and say who else
                           lost the modem

Profiles
  fixed       the repairs in this package, and the units that keep them there
  shipped     FuriOS exactly as it came: no patches, no fallback route, and no
              name resolution once Wi-Fi is off

Options
  -q, --quiet              only errors (for boot units and apt hooks)
      --no-restart         change files, leave the services alone
      --restart            revert: restart the modem stack afterwards
      --patches-only       revert: ofono2mm's files only, not the config
      --force              sim: switch to a slot even without a card in it;
                           mtk-build: build again although one fits
      --if-stale           mtk-build: only when a package update outdated
                           the build in place (the apt hook)

The fixes live in files owned by the ofono2mm package. They are put in with
dpkg-divert, so an update of that package lands beside them as .distrib, and
our copy has to be made again from it. A boot unit and an apt hook run "boot"
for you; both do nothing when there is nothing to do. "try" is how you look at
the phone without them for a while: the next boot puts back whatever "set"
recorded.
USAGE
}

CMD=${1:-status}
shift 2>/dev/null || true

# Behind pkexec, only what the app's switches send. The polkit action lets the
# person at the phone run this as root without a password, and the action can
# name a binary but not its arguments - so without this, "pkexec modemctl
# revert", "mtk-build --force" or any future verb would be a password-less
# root tool. The list is exactly the app's calls: set/try with a profile, sim
# with a slot, nr on/off, each with one argument and no options (--force on
# sim would switch to an empty slot). Anything else is for sudo, which asks.
if [ -n "${PKEXEC_UID:-}" ]; then
    allowed=""
    if [ $# -eq 1 ]; then
        case "$CMD:$1" in
            set:fixed|set:shipped|try:fixed|try:shipped) allowed=1 ;;
            sim:[1-9])                                   allowed=1 ;;
            nr:on|nr:off)                                allowed=1 ;;
        esac
    fi
    if [ -z "$allowed" ]; then
        echo "refusing \"modemctl $CMD${*:+ $*}\" through pkexec - only set|try fixed|shipped, sim <slot> and nr on|off go without a password; use sudo for the rest" >&2
        exit 4
    fi
fi

for a in "$@"; do
    case "$a" in
        -q|--quiet)     QUIET=1 ;;
        --no-restart)   NO_RESTART=1 ;;
        --patches-only) PATCHES_ONLY=1 ;;
        --restart)      DO_RESTART=1 ;;
        --force)        FORCE=1 ;;
        --if-stale)     IF_STALE=1 ;;
    esac
done

case "$CMD" in
    status)       cmd_status ;;
    apply)        cmd_apply ;;
    revert)       cmd_revert ;;
    profile)      cmd_profile ;;
    set)          cmd_switch "${1:-}" 1 ;;
    try)          cmd_switch "${1:-}" "" ;;
    boot)         cmd_boot ;;
    adopt)        cmd_adopt ;;
    settle)       cmd_settle ;;
    check)        cmd_check ;;
    signal)       cmd_signal ;;
    sim)          cmd_sim "${1:-}" ;;
    sim-check)    cmd_sim_check ;;
    nr)           cmd_nr "${1:-}" ;;
    nr-boot)      cmd_nr_boot ;;
    mtk-build)    cmd_mtk_build ;;
    version|-V|--version)
        # VERSION is this script's own interface version and moves rarely. The
        # question people actually ask here is "which build is on this phone",
        # and dpkg is the only thing that knows - so say both, and say nothing
        # about a package when this was installed by hand.
        echo "modemctl $VERSION"
        pkgver=$(dpkg-query -W -f='${Version}' furios-modem-fixes 2>/dev/null)
        [ -n "${pkgver:-}" ] && echo "furios-modem-fixes $pkgver"
        ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac
